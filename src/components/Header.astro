---
import { loadGlobal } from '../lib/content';
import Nav from './Nav.astro';

const { name } = loadGlobal();
---

<header class="masthead" role="banner">
  <a href="/" class="wordmark" aria-label={`${name} — go to homepage`}>
    {name.toLowerCase()}
  </a>

  <Nav />
</header>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .masthead {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    padding: 2.5rem var(--gutter) 1.5rem;
  }

  .masthead::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: var(--gutter);
    right: var(--gutter);
    height: 5px;
    background: linear-gradient(90deg, var(--forest), var(--charred));
    opacity: 0.8;
  }

  .wordmark {
    font-weight: 800;
    font-size: clamp(2.75rem, 9vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--forest);
    text-decoration: none;
    display: block;
  }

  @include small {
    .masthead {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding-block: 1.5rem 0.5rem;
    }
  }
</style>

---
// Options are [{ value, label }]; clicking one dispatches a bubbling tt:toggle with { name, value }
const { name, label, value, options } = Astro.props;
const index = Math.max(0, options.findIndex((o: { value: string }) => o.value === value));
---

<div
  class="segmented"
  role="group"
  aria-label={label}
  data-name={name}
  data-value={value}
  style={`--count: ${options.length}; --index: ${index}`}
>
  <span class="thumb" aria-hidden="true"></span>
  {options.map((o: { value: string; label: string }) => (
    <button class="option" type="button" data-value={o.value} aria-pressed={String(o.value === value)}>
      {o.label}
    </button>
  ))}
</div>

<script>
  document.addEventListener('click', e => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('.segmented .option');
    const root = btn?.closest<HTMLElement>('.segmented');
    if (!btn || !root || root.dataset.value === btn.dataset.value) return;
    const options = [...root.querySelectorAll<HTMLButtonElement>('.option')];
    root.dataset.value = btn.dataset.value;
    root.style.setProperty('--index', String(options.indexOf(btn)));
    for (const o of options) o.setAttribute('aria-pressed', String(o === btn));
    root.dispatchEvent(
      new CustomEvent('tt:toggle', { bubbles: true, detail: { name: root.dataset.name, value: btn.dataset.value } })
    );
  });
</script>

<style lang="scss">
  .segmented {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), 1fr);
    flex-shrink: 0;
    height: 100%;
    padding: 0.2rem;
    background: rgb(27 31 26 / 0.06);
    border-radius: 0.6rem;
  }

  // Cells share one width, so the thumb slides by whole multiples of its own width
  .thumb {
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0.2rem;
    width: calc((100% - 0.4rem) / var(--count));
    background: var(--forest);
    border-radius: 0.45rem;
    box-shadow: 0 1px 3px rgb(27 31 26 / 0.18);
    transform: translateX(calc(var(--index) * 100%));
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb { transition: none; }
  }

  .option {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0 0.85rem;
    border: 0;
    border-radius: 0.45rem;
    background: none;
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--battleship);
    cursor: pointer;
    transition: color 200ms ease;
  }

  .option[aria-pressed='true'] {
    color: #fff;
  }

  .option:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 2px;
  }
</style>

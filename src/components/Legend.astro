---
const genera = [
  { icon: 'maple',       label: 'Maple',        pct: 27,   color: 'var(--celery)'     },
  { icon: 'locust',      label: 'Locust',       pct: 9,    color: 'var(--golden)'     },
  { icon: 'spruce-pine', label: 'Spruce, pine', pct: 9,    color: 'var(--rope)'       },
  { icon: 'oak',         label: 'Oak',          pct: 8,    color: 'var(--killarney)'  },
  { icon: 'linden',      label: 'Linden',       pct: 7,    color: 'var(--gull)'       },
  { icon: 'elm',         label: 'Elm',          pct: 4,    color: 'var(--asparagus)'  },
  { icon: 'apple',       label: 'Apple',        pct: 3,    color: 'var(--punch)'      },
  { icon: 'ginkgo',      label: 'Ginkgo',       pct: 2,    color: 'var(--raj)'        },
  { icon: 'birch',       label: 'Birch',        pct: 2,    color: 'var(--geyser)'     },
  { icon: 'cherry',      label: 'Cherry',       pct: 2,    color: 'var(--blush)'      },
  { icon: 'ash',         label: 'Ash',          pct: 1,    color: 'var(--terracotta)' },
  { icon: 'catalpa',     label: 'Catalpa',      pct: 0.5,  color: 'var(--lavender)'   },
  { icon: 'other',       label: 'Other',        pct: 26,   color: 'var(--bombay)'     },
];

const fmt = (p: number) => (p < 1 ? '<1%' : `${Math.round(p)}%`);
---

<section class="legend" aria-label="Map legend">
  <div class="scale">
    <span class="scale-note">trunk Ø 10–90 cm</span>
    <div class="dots" aria-hidden="true">
      <span style="width: 0.3rem;  height: 0.3rem"></span>
      <span style="width: 0.55rem; height: 0.55rem"></span>
      <span style="width: 0.9rem;  height: 0.9rem"></span>
      <span style="width: 1.4rem;  height: 1.4rem"></span>
    </div>
  </div>

  <ul class="genera" role="list">
    {genera.map(g => (
      <li>
        <div class="leaf-slot">
          <img
            src={`/icons/leaves/${g.icon}.png`}
            alt=""
            class="leaf"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="name">{g.label}</span>
        <div
          class="bar"
          role="img"
          aria-label={`${fmt(g.pct)} of trees`}
        >
          <span style={`width: ${Math.max(g.pct, 0.75)}%; background: ${g.color}`}></span>
        </div>
        <span class="pct">{fmt(g.pct)}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .legend {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding: 2rem var(--gutter);
    font-size: var(--text-sm);
    color: var(--charred);
  }

  .legend::before,
  .legend::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    height: 5px;
    background: linear-gradient(90deg, var(--forest), var(--charred));
    opacity: 0.8;
  }
  .legend::before { top: 0; }
  .legend::after  { bottom: 0; }

  .scale {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .scale-note {
    font-size: var(--text-xs);
    color: var(--battleship);
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dots span {
    display: inline-block;
    background: var(--forest);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .genera {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 0.25rem 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .genera li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    width: 100%;
  }

  .leaf-slot {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .leaf {
    height: 3rem;
    width: auto;
    max-width: 100%;
    display: block;
  }

  .name {
    font-size: var(--text-xs);
    color: var(--charred);
    line-height: 1.2;
    min-height: 2.4em; /* reserves 2 lines so bar + pct align across columns */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pct {
    font-size: var(--text-xs);
    color: var(--battleship);
    font-variant-numeric: tabular-nums;
  }

  .bar {
    width: 100%;
    height: 0.375rem;
    background: rgb(27 31 26 / 0.08);
    border-radius: 0.2rem;
    overflow: hidden;
    margin-block: 0.3rem 0.15rem;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: 2px;
    min-width: 2px;
  }

  @include large {
    .legend {
      flex-direction: column;
      gap: 1.5rem;
    }
    .genera {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
  }

  @include small {
    .genera {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
// Percentages are genus share of the 688,335 street trees in the City of Toronto inventory
const genera = [
  { icon: 'maple',               label: 'Maple',               pct: 26.97, color: 'var(--celery)'      },
  { icon: 'locust',              label: 'Locust',              pct: 8.7,   color: 'var(--golden)'      },
  { icon: 'spruce-pine',         label: 'Spruce, pine',        pct: 8.52,  color: 'var(--rope)'        },
  { icon: 'oak',                 label: 'Oak',                 pct: 7.49,  color: 'var(--killarney)'   },
  { icon: 'linden',              label: 'Linden',              pct: 6.72,  color: 'var(--golden)'      },
  { icon: 'elm',                 label: 'Elm',                 pct: 4.29,  color: 'var(--asparagus)'   },
  { icon: 'kentucky-coffeetree', label: 'Kentucky coffeetree', pct: 3.12,  color: 'var(--spectra)'     },
  { icon: 'apple',               label: 'Apple',               pct: 2.76,  color: 'var(--punch)'       },
  { icon: 'lilac',               label: 'Lilac tree',          pct: 2.71,  color: 'var(--lavender)'    },
  { icon: 'ginkgo',              label: 'Ginkgo',              pct: 2.54,  color: 'var(--raj)'         },
  { icon: 'hackberry',           label: 'Hackberry',           pct: 2.06,  color: 'var(--killarney)'   },
  { icon: 'birch',               label: 'Birch',               pct: 1.82,  color: 'var(--geyser)'      },
  { icon: 'serviceberry',        label: 'Serviceberry',        pct: 1.75,  color: 'var(--casablanca)'  },
  { icon: 'horse-chestnut',      label: 'Horse chestnut',      pct: 1.73,  color: 'var(--killarney)'   },
  { icon: 'ornamental-pear',     label: 'Ornamental pear',     pct: 1.68,  color: 'var(--raj)'         },
  { icon: 'cherry',              label: 'Cherry',              pct: 1.52,  color: 'var(--blush)'       },
  { icon: 'ash',                 label: 'Ash',                 pct: 1.45,  color: 'var(--terracotta)'  },
  { icon: 'sycamore',            label: 'Sycamore',            pct: 1.34,  color: 'var(--gumleaf)'     },
  { icon: 'cedar',               label: 'Cedar',               pct: 1.21,  color: 'var(--killarney)'   },
  { icon: 'tulip-tree',          label: 'Tulip tree',          pct: 1.13,  color: 'var(--asparagus)'   },
  { icon: 'catalpa',             label: 'Catalpa',             pct: 1.11,  color: 'var(--lavender)'    },
  { icon: 'mulberry',            label: 'Mulberry',            pct: 1.07,  color: 'var(--lavender)'    },
  { icon: 'beech',               label: 'Beech',               pct: 0.7,   color: 'var(--rope)'        },
  { icon: 'rowan',               label: 'Rowan',               pct: 0.63,  color: 'var(--pomegranate)' },
  { icon: 'magnolia',            label: 'Magnolia',            pct: 0.48,  color: 'var(--zinnwaldite)' },
  { icon: 'walnut',              label: 'Walnut',              pct: 0.42,  color: 'var(--kabul)'       },
  { icon: 'tree-of-heaven',      label: 'Tree of heaven',      pct: 0.22,  color: 'var(--pomegranate)' },
  { icon: 'other',               label: 'Other',               pct: 5.86,  color: 'var(--bombay)'      },
];

const fmt = (p: number) =>
  p >= 10 ? `${Math.round(p)}%` : p >= 1 ? `${p.toFixed(1)}%` : `${p.toFixed(2)}%`;
---

<section class="legend" aria-label="Map legend">
  <div class="scale">
    <span class="scale-note">trunk Ø 10–90 cm</span>
    <div class="dots" aria-hidden="true">
      <span style="width: 0.3rem;  height: 0.3rem"></span>
      <span style="width: 0.55rem; height: 0.55rem"></span>
      <span style="width: 0.9rem;  height: 0.9rem"></span>
      <span style="width: 1.4rem;  height: 1.4rem"></span>
    </div>
  </div>

  <ul class="genera" role="list">
    {genera.map(g => (
      <li>
        <div class="leaf-slot">
          <img
            src={`/icons/leaves/${g.icon}.png`}
            alt=""
            class="leaf"
            loading="lazy"
            decoding="async"
          />
        </div>
        <span class="name">{g.label}</span>
        <div
          class="bar"
          role="img"
          aria-label={`${fmt(g.pct)} of trees`}
        >
          <span style={`width: ${Math.max(g.pct, 0.75)}%; background: ${g.color}`}></span>
        </div>
        <span class="pct">{fmt(g.pct)}</span>
      </li>
    ))}
  </ul>
</section>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .legend {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding: 2rem var(--gutter);
    font-size: var(--text-sm);
    color: var(--charred);
  }

  .legend::before,
  .legend::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    height: 5px;
    background: linear-gradient(90deg, var(--forest), var(--charred));
    opacity: 0.8;
  }
  .legend::before { top: 0; }
  .legend::after  { bottom: 0; }

  .scale {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .scale-note {
    font-size: var(--text-xs);
    color: var(--battleship);
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dots span {
    display: inline-block;
    background: var(--forest);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .genera {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 0.75rem 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .genera li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    width: 100%;
  }

  .leaf-slot {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .leaf {
    height: 3rem;
    width: auto;
    max-width: 100%;
    display: block;
  }

  .name {
    font-size: var(--text-xs);
    color: var(--charred);
    line-height: 1.2;
    min-height: 2.4em; /* reserves 2 lines so bar + pct align across columns */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pct {
    font-size: var(--text-xs);
    color: var(--battleship);
    font-variant-numeric: tabular-nums;
  }

  .bar {
    width: 100%;
    height: 0.375rem;
    background: rgb(27 31 26 / 0.08);
    border-radius: 0.2rem;
    overflow: hidden;
    margin-block: 0.3rem 0.15rem;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: 2px;
    min-width: 2px;
  }

  @include xxl {
    .genera {
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }
  }

  @include large {
    .legend {
      flex-direction: column;
      gap: 1.5rem;
    }
    .genera {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @include small {
    .genera {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

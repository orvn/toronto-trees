  { icon: 'other',               label: 'Other',               pct: 0.57,  color: 'var(--bombay)'     },
];

const fmt = (p: number) =>
  p >= 10 ? `${Math.round(p)}%` : p >= 1 ? `${p.toFixed(1)}%` : `${p.toFixed(2)}%`;
---

<section class="legend" aria-label="Map legend">
  <div class="scale">
    <span class="scale-note">trunk Ø 10–90 cm</span>
    <div class="dots" aria-hidden="true">
      <span style="width: 0.3rem;  height: 0.3rem"></span>
      <span style="width: 0.55rem; height: 0.55rem"></span>
      <span style="width: 0.9rem;  height: 0.9rem"></span>
      <span style="width: 1.4rem;  height: 1.4rem"></span>
    </div>
  </div>

  <div class="genera-wrap">
    <div class="drawer">
      <ul class="genera" id="genera" role="list">
        {genera.map(g => (
          <li>
            <button class="genus" type="button" data-icon={g.icon} aria-pressed="false">
              <div class="leaf-slot">
                <img
                  src={`/icons/leaves/${g.icon}.png`}
                  alt=""
                  class="leaf"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="name">{g.label}</span>
              <div
                class="bar"
                role="img"
                aria-label={`${fmt(g.pct)} of trees`}
              >
                <span style={`width: ${Math.max(g.pct, 0.75)}%; background: ${g.color}`}></span>
              </div>
              <span class="pct">{fmt(g.pct)}</span>
            </button>
          </li>
        ))}
        <li class="more-cell" hidden>
          <button class="more" type="button" aria-expanded="false" aria-controls="genera">
            <span class="leaf-slot"><span class="glyph" aria-hidden="true">+</span></span>
            <span class="name">more</span>
            <span class="pct count"></span>
          </button>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  // Selection is broadcast not passed down, so Map.astro is independent of legend
  const FILTER_EVENT = 'tt:genus-filter';

  let teardown: (() => void) | null = null;

  function initLegend() {
    teardown?.();
    teardown = null;

    const list = document.querySelector<HTMLUListElement>('.legend .genera');
    if (!list) return;

    const buttons = [...list.querySelectorAll<HTMLButtonElement>('.genus')];
    let selected: string | null = null;

    // Collapse to two rows; the row count depends on the grid's column breakpoint.
    // The toggle is a grid cell: collapsed it takes the last slot of row two, expanded it trails the list
    const drawer = list.parentElement as HTMLElement;
    const moreCell = list.querySelector<HTMLElement>('.more-cell');
    const more = list.querySelector<HTMLButtonElement>('.more');
    const items = [...list.children].filter(li => li !== moreCell) as HTMLElement[];
    items.forEach((li, i) => (li.style.order = String(i)));
    let expanded = false;
    let hiddenCount = 0;

    const rowTops = () => [...new Set(items.map(li => li.offsetTop))];

    const setLabels = () => {
      if (!more) return;
      more.querySelector('.glyph')!.textContent = expanded ? '−' : '+';
      more.querySelector('.name')!.textContent = expanded ? 'fewer' : 'more';
      more.querySelector('.count')!.textContent = `${expanded ? '−' : '+'}${hiddenCount}`;
    };

    const layout = () => {
      if (!more || !moreCell) return;
      // Measured with the toggle parked at the end so it never shifts the rows being counted
      moreCell.style.order = String(items.length);
      let tops = rowTops();
      const hasMore = tops.length > 2;
      const open = expanded || !hasMore;
      moreCell.hidden = !hasMore;
      if (hasMore) {
        const cols = items.filter(li => li.offsetTop === tops[0]).length;
        hiddenCount = items.length - (cols * 2 - 1);
        moreCell.style.order = String(open ? items.length : cols * 2 - 2);
        tops = rowTops();
      }
      if (!more.classList.contains('is-swapping')) setLabels();
      const row2 = items.find(li => li.offsetTop === tops[1]) ?? items[0];
      drawer.style.maxHeight = `${open ? list.scrollHeight : row2.offsetTop + row2.offsetHeight}px`;
      for (const li of items) li.toggleAttribute('inert', !open && li.offsetTop >= tops[2]);
    };

    // FLIP: the toggle is laid out in its new slot, then animated from where it was.
    // It follows the grid lines: opening goes down then across, closing goes across then up
    const flip = (run: () => void) => {
      if (!moreCell) return run();
      const a = moreCell.getBoundingClientRect();
      run();
      const b = moreCell.getBoundingClientRect();
      const dx = a.left - b.left;
      const dy = a.top - b.top;
      if ((!dx && !dy) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const legs = [`translate(${dx}px, ${dy}px)`];
      if (dx && dy) legs.push(expanded ? `translate(${dx}px, 0)` : `translate(0, ${dy}px)`);
      legs.push('none');
      moreCell.animate(
        legs.map(transform => ({ transform, easing: 'ease-in-out' })),
        { duration: 220 * (legs.length - 1) }
      );
    };

    more?.addEventListener('click', () => {
      expanded = !expanded;
      more.setAttribute('aria-expanded', String(expanded));
      more.classList.add('is-swapping');
      flip(layout);
      setTimeout(() => {
        setLabels();
        more.classList.remove('is-swapping');
      }, 150);
    });

    const observer = new ResizeObserver(layout);
    observer.observe(list);

    const paint = () => {
      list.classList.toggle('is-filtering', selected !== null);
      for (const b of buttons) {
        b.setAttribute('aria-pressed', String(b.dataset.icon === selected));
      }
    };

    const apply = () => {
      paint();
      document.dispatchEvent(new CustomEvent(FILTER_EVENT, { detail: { source: 'legend', icon: selected } }));
    };

    // The search bar drives the same filter; mirror its genus here without re-dispatching
    const onFilter = (e: Event) => {
      const d = (e as CustomEvent).detail ?? {};
      if (d.source === 'legend') return;
      selected = d.icon ?? null;
      paint();
    };
    document.addEventListener(FILTER_EVENT, onFilter);

    for (const b of buttons) {
      b.addEventListener('click', () => {
        selected = selected === b.dataset.icon ? null : b.dataset.icon ?? null;
        apply();
      });
    }

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && selected !== null) {
        selected = null;
        apply();
      }
    };
    document.addEventListener('keydown', onKeydown);
    teardown = () => {
      document.removeEventListener('keydown', onKeydown);
      document.removeEventListener(FILTER_EVENT, onFilter);
      observer.disconnect();
    };
  }

  document.addEventListener('astro:page-load', initLegend);
  document.addEventListener('astro:before-swap', () => {
    teardown?.();
    teardown = null;
  });
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .legend {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    margin-top: 1.5rem;
    padding: 2rem var(--gutter);
    font-size: var(--text-sm);
    color: var(--charred);
  }

  .legend::before,
  .legend::after {
    content: '';
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    height: 5px;
    background: linear-gradient(90deg, var(--forest), var(--charred));
    opacity: 0.8;
  }
  .legend::before { top: 0; }
  .legend::after  { bottom: 0; }

  .scale {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .scale-note {
    font-size: var(--text-xs);
    color: var(--battleship);
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dots span {
    display: inline-block;
    background: var(--forest);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .genera-wrap {
    flex: 1;
    min-width: 0;
  }

  .drawer {
    position: relative;
    overflow: hidden;
    transition: max-height 300ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .more > * { transition: none; }
  }


  .genera li[hidden] {
    display: none;
  }

  .more {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0.25rem 0.1rem;
    border: 0;
    border-radius: 0.3rem;
    background: none;
    font: inherit;
    color: var(--forest);
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .more > * {
    transition: opacity 150ms ease;
  }

  .more.is-swapping > * {
    opacity: 0;
  }

  .more .glyph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding-bottom: 0.25rem; /* glyphs sit low in the em box, so nudge up to centre optically */
    border: 1.5px solid var(--forest);
    border-radius: 50%;
    font-size: 1.4rem;
    font-weight: 300;
    line-height: 1;
  }

  .more .name {
    color: var(--forest);
    font-weight: 500;
  }

  .more .count {
    margin-top: 0.825rem; /* matches the bar's height and margins so it lines up with the pct row */
    color: var(--forest);
    opacity: 0.7;
  }

  .more:hover {
    background: rgb(47 143 59 / 0.08);
  }

  .more:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
  }

  .genera {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 0.75rem 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .genera li {
    display: flex;
    width: 100%;
  }

  .genus {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    width: 100%;
    padding: 0.25rem 0.1rem;
    margin: 0;
    border: 0;
    border-radius: 0.3rem;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
    opacity: 1;
    transition: opacity 150ms ease, background-color 150ms ease;
  }

  .genus:hover {
    background: rgb(27 31 26 / 0.05);
  }

  .genus:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
  }

  .genera.is-filtering .genus[aria-pressed='false'] {
    opacity: 0.5;
  }

  .leaf-slot {
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .leaf {
    height: 3rem;
    width: auto;
    max-width: 100%;
    display: block;
  }

  .name {
    font-size: var(--text-xs);
    color: var(--charred);
    line-height: 1.2;
    min-height: 2.4em; /* reserves 2 lines so bar + pct align across columns */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pct {
    font-size: var(--text-xs);
    color: var(--battleship);
    font-variant-numeric: tabular-nums;
  }

  .bar {
    width: 100%;
    height: 0.375rem;
    background: rgb(27 31 26 / 0.08);
    border-radius: 0.2rem;
    overflow: hidden;
    margin-block: 0.3rem 0.15rem;
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: 2px;
    min-width: 2px;
  }

  @include xxl {
    .genera {
      grid-template-columns: repeat(10, minmax(0, 1fr));
    }
  }

  @include large {
    .legend {
      flex-direction: column;
      gap: 1.5rem;
    }
    .genera {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @include small {
    .genera {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

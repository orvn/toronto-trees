---
import { loadFragment } from '../lib/content';
import GithubIcon from './GithubIcon.astro';

const { links } = loadFragment<{ links: { label: string; href: string; icon: string | null }[] }>('nav');
const icons = { github: GithubIcon };
const { pathname } = Astro.url;

function isActive(href: string): boolean {
  return href === '/' ? pathname === '/' : pathname.startsWith(href);
}
---

<nav class="nav" aria-label="Main navigation">
  <ul role="list">
    {links.map(({ label, href, icon }) => {
      const Icon = icon && icons[icon as keyof typeof icons];
      const external = href.startsWith('http');
      return (
        <li>
          <a
            href={href}
            class:list={['nav-link', { 'has-icon': Icon }]}
            aria-current={isActive(href) ? 'page' : undefined}
            aria-label={Icon ? label : undefined}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
          >{Icon ? <Icon /> : label}</a>
        </li>
      );
    })}
  </ul>
</nav>

<style lang="scss">
  .nav {
    padding-bottom: 0.3rem;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-link {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--charred);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--forest);
  }

  // lowercase labels sit low in their line box, so icons are nudged to match
  .has-icon {
    display: inline-flex;
    cursor: pointer;
    transform: translateY(0.15rem);

    :global(svg) {
      pointer-events: none;
    }
  }
</style>

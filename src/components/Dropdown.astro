---
// Options are [{ value, label }]
const { name, label, value, options, class: className } = Astro.props;
const current = options.find((o: { value: string }) => o.value === value) ?? options[0];
---

<label class:list={['dropdown', className]}>
  <slot name="icon" />
  <span class="current">{current.label}</span>
  <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
  <select name={name} aria-label={label}>
    {options.map((o: { value: string; label: string }) => (
      <option value={o.value} selected={o.value === current.value}>{o.label}</option>
    ))}
  </select>
</label>

<script>
  document.addEventListener('change', e => {
    const select = e.target as HTMLSelectElement;
    const root = select.closest<HTMLElement>('.dropdown');
    const current = root?.querySelector('.current');
    if (!root || !current) return;
    const from = root.offsetWidth;
    current.textContent = select.selectedOptions[0]?.text ?? '';
    root.style.width = '';
    const to = root.offsetWidth;
    if (from === to) return;
    root.style.width = `${from}px`;
    root.offsetWidth;
    root.style.width = `${to}px`;
    root.addEventListener('transitionend', () => (root.style.width = ''), { once: true });
  });
</script>

<style lang="scss">
  @use '../styles/panel' as *;

  .dropdown {
    @include key;
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: 0.375rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--charred);
    overflow: hidden;
    white-space: nowrap;
    cursor: pointer;
    transition: width 220ms ease;
  }

  .current {
    min-width: 0;
  }

  .dropdown:has(select:focus-visible) {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
  }

  .chevron {
    flex-shrink: 0;
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: var(--battleship);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    font-size: 1rem;
    cursor: pointer;
  }
</style>

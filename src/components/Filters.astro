---
import { loadFragment } from '../lib/content';
import SearchBox from './SearchBox.astro';
import RangeSlider from './RangeSlider.astro';
import SegmentedToggle from './SegmentedToggle.astro';
import Dropdown from './Dropdown.astro';

const copy = loadFragment<Record<string, string>>('filters');
---

<div class="filters-wrap">
  <div class="filters" data-mode="trees" data-group="search">
    <Dropdown
      name="filter-mode"
      label={copy.mode_select_label}
      class="mode"
      value="trees"
      options={[
        { value: 'trees', label: copy.mode_trees },
        { value: 'address', label: copy.mode_address },
        { value: 'age', label: copy.range_mode_age },
        { value: 'dbh', label: copy.range_mode_trunk },
      ]}
    >
      <span class="filter-icon" slot="icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 5h16l-6 7.5V19l-4-2v-4.5z" /></svg>
      </span>
    </Dropdown>
    <div class="bar ranges">
      <SegmentedToggle
        name="range"
        label={copy.range_mode_label}
        value="age"
        options={[
          { value: 'age', label: copy.range_mode_age },
          { value: 'dbh', label: copy.range_mode_trunk },
        ]}
      />
      <div class="slider-stack">
        <RangeSlider
          name="age"
          label={copy.age_label}
          labelHidden
          min={0}
          max={200}
          unit={copy.age_unit}
          minLabel={copy.age_min_label}
          maxLabel={copy.age_max_label}
          anyText={copy.age_any}
          underText={copy.age_under}
          overText={copy.age_over}
          betweenText={copy.age_between}
          resetLabel={copy.reset_age}
        />
        <RangeSlider
          name="dbh"
          label={copy.trunk_label}
          labelHidden
          hidden
          min={0}
          max={150}
          unit={copy.trunk_unit}
          minLabel={copy.trunk_min_label}
          maxLabel={copy.trunk_max_label}
          anyText={copy.trunk_any}
          underText={copy.trunk_under}
          overText={copy.trunk_over}
          betweenText={copy.trunk_between}
          resetLabel={copy.reset_trunk}
        />
      </div>
    </div>
    <div class="bar search-bar">
      <SearchBox copy={copy} />
    </div>
  </div>
</div>

<script>
  // Each control reports its bounds and the bar merges them into one event to pass to map
  const RANGE_EVENT = 'tt:range-filter';
  // Wait for range control to settle before passing to map
  const RANGE_SETTLE_MS = 120;
  const RANGE_MODES = new Set(['age', 'dbh']);

  let rangeOn = false;
  let speciesOn = false;
  const paintActive = () =>
    document.querySelector('.filters')?.classList.toggle('has-filters', rangeOn || speciesOn);
  document.addEventListener(RANGE_EVENT, e => {
    rangeOn = Object.values((e as CustomEvent).detail ?? {}).some(v => v !== null);
    paintActive();
  });
  document.addEventListener('tt:genus-filter', e => {
    const { icon = null, picks = [] } = (e as CustomEvent).detail ?? {};
    speciesOn = Boolean(icon || picks.length);
    paintActive();
  });

  document.addEventListener('astro:page-load', () => {
    const bar = document.querySelector<HTMLElement>('.filters');
    if (!bar) return;
    rangeOn = speciesOn = false;

    // One range at a time: the toggle swaps which slider shows and clears the one going away
    bar.addEventListener('tt:toggle', e => {
      const { name, value } = (e as CustomEvent).detail;
      if (name !== 'range') return;
      for (const slider of bar.querySelectorAll<HTMLElement>('.range-slider')) {
        const show = slider.dataset.name === value;
        if (!show && slider.classList.contains('is-active')) slider.querySelector<HTMLButtonElement>('.reset')?.click();
        slider.hidden = !show;
      }
    });

    // Mobile shows one control at a time (dropdown)
    const modeSelect = bar.querySelector<HTMLSelectElement>('.mode select');
    const groupOf = (mode: string) => (RANGE_MODES.has(mode) ? 'range' : 'search');
    const setMode = (mode: string) => {
      bar.dataset.mode = mode;
      bar.dataset.group = groupOf(mode);
      if (modeSelect && modeSelect.value !== mode) {
        modeSelect.value = mode;
        modeSelect.dispatchEvent(new Event('change', { bubbles: true }));
      }
    };
    modeSelect?.addEventListener('change', () => {
      const mode = modeSelect.value;
      if (mode === bar.dataset.mode) return;
      const host = groupOf(mode) === 'range' ? '.ranges' : '.search-bar';
      bar.querySelector<HTMLButtonElement>(`${host} .segmented .option[data-value="${mode}"]`)?.click();
      setMode(mode);
    });
    bar.addEventListener('tt:toggle', e => {
      const { value } = (e as CustomEvent).detail;
      if (groupOf(value) === bar.dataset.group) setMode(value);
    });

    const state: Record<string, number | null> = { ageMin: null, ageMax: null, dbhMin: null, dbhMax: null };
    let timer = 0;
    bar.addEventListener('tt:range', e => {
      const { name, min, max } = (e as CustomEvent).detail;
      state[`${name}Min`] = min;
      state[`${name}Max`] = max;
      clearTimeout(timer);
      timer = window.setTimeout(
        () => document.dispatchEvent(new CustomEvent(RANGE_EVENT, { detail: { ...state } })),
        RANGE_SETTLE_MS
      );
    });
  });
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  @use '../styles/panel' as *;

  // Above the map so the search results can drop over it
  .filters-wrap {
    position: relative;
    z-index: var(--z-above);
    padding-inline: var(--gutter);
    padding-top: 1.5rem;
  }

  .filters {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .bar {
    @include panel;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.625rem;
  }

  .ranges {
    flex-shrink: 0;
    padding-right: 1.125rem;
  }

  .slider-stack {
    display: grid;

    > :global(*) {
      grid-area: 1 / 1;
    }

    > :global(.range-slider[hidden]) {
      display: flex;
      visibility: hidden;
    }
  }

  .search-bar {
    flex: 1 1 22rem;
    min-width: 0;
  }

  .search-bar > :global(*) {
    flex: 1;
    min-width: 0;
  }

  .bar :global(.option),
  .bar :global(.value),
  .bar :global(.results li) {
    font-size: var(--text-xs);
  }

  .bar :global(.query),
  .bar :global(.query:focus) {
    font-size: var(--text-sm);
  }

  .bar :global(.results .sub),
  .bar :global(.results .count) {
    font-size: 0.75rem;
  }

  @include xl {
    .filters {
      flex-wrap: wrap;
      row-gap: 1.25rem;
    }
    .bar {
      flex-basis: 100%;
    }
  }

  @include medium {
    .bar {
      padding: 0.5rem;
    }
    .ranges {
      flex-wrap: wrap;
      row-gap: 0.75rem;
    }
    .ranges > :global(*) {
      flex-basis: 100%;
    }
  }

  // stabilize ios zoom on input
  @include touch {
    .bar :global(.query),
    .bar :global(.query:focus) {
      font-size: 1rem;
    }
  }

  .filters > :global(.mode) {
    display: none;
  }

  .filter-icon {
    position: relative;
    display: flex;

    svg {
      width: 0.875rem;
      height: 0.875rem;
      fill: none;
      stroke: var(--charred);
      stroke-width: 2;
      stroke-linejoin: round;
    }
  }

  .has-filters .filter-icon::after {
    content: '';
    position: absolute;
    top: -0.125rem;
    right: -0.1875rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border: 1.5px solid var(--bianca);
    border-radius: 50%;
    background: var(--forest);
  }

  // Mobile dropdown filters
  @include small {
    .filters-wrap {
      padding-top: 1rem;
    }
    .filters {
      @include panel;
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding: 0.375rem;
    }
    .filters > :global(.mode) {
      display: inline-flex;
    }
    .bar {
      position: static;
      flex: 1 1 0;
      min-width: 0;
      padding: 0;
      border: 0;

      &::before,
      &::after {
        display: none;
      }
    }
    [data-group='search'] .ranges,
    [data-group='range'] .search-bar {
      display: none;
    }
    .ranges > :global(.segmented),
    .search-bar :global(.field > .segmented) {
      display: none;
    }
    .slider-stack {
      flex: 1;
      min-width: 0;
    }
    .ranges :global(.scale) {
      min-width: 4rem;
    }
    .bar :global(.query) {
      text-overflow: ellipsis;
    }
    .bar :global(.query::placeholder) {
      font-size: var(--text-xs);
    }
    .search-bar :global(.search) {
      position: static;
    }
    .search-bar :global(.results-panel) {
      top: calc(100% + 1rem);
      left: -2px;
      right: -2px;
    }
  }
</style>

---
// Small × button shared by the search field, street chip, and range resets
const { label, size = 'sm', variant = 'disc', class: className, hidden = false, ghost = false } = Astro.props;
---

<button class:list={['clear-btn', size, variant, className, { ghost }]} type="button" aria-label={label} hidden={hidden}>
  <span class="bar" aria-hidden="true"></span>
  <span class="bar" aria-hidden="true"></span>
</button>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  @use '../styles/panel' as *;

  .clear-btn {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(27 31 26 / 0.06);
    color: var(--battleship);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .clear-btn[hidden] {
    display: none;
  }

  .ghost {
    visibility: hidden;
    pointer-events: none;
  }

  .clear-btn:hover {
    background: rgb(27 31 26 / 0.12);
    color: var(--charred);
  }

  .clear-btn:focus-visible {
    outline: 2px solid var(--forest);
    outline-offset: 1px;
  }

  .bar {
    position: absolute;
    inset: 0;
    width: 0.6rem;
    height: 0.1rem;
    margin: auto;
    border-radius: 0.05rem;
    background: currentColor;
    transform: rotate(45deg);
  }

  .bar + .bar {
    transform: rotate(-45deg);
  }

  .sm {
    width: 1.5rem;
    height: 1.5rem;
  }

  .md {
    width: 1.75rem;
    height: 1.75rem;
  }

  .md .bar {
    width: 0.65rem;
  }

  .flat {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 0.35rem;
    background: none;
    color: inherit;
  }

  .flat:hover {
    background: rgb(47 143 59 / 0.15);
    color: inherit;
  }

  .lg {
    width: 1.375rem;
    height: 1.375rem;
  }

  // The key chrome sits on its own layer so a parent can fade it away
  .key {
    border-radius: 0.375rem;
    background: none;
    color: var(--charred);
    transition: transform 120ms ease, color 150ms ease;
  }

  .key::before {
    @include key;
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    transition: opacity 200ms ease, box-shadow 120ms ease;
  }

  .key:hover {
    background: none;
    color: var(--forest);
  }

  .key:active {
    transform: translateY(2px);
  }

  .key:active::before {
    box-shadow: none;
  }

  @include touch {
    .sm,
    .flat {
      width: 2rem;
      height: 2rem;
    }

    .md {
      width: 2.25rem;
      height: 2.25rem;
    }

    .lg {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  @include small {
    .sm,
    .flat {
      width: 1.75rem;
      height: 1.75rem;
    }

    .md {
      width: 2rem;
      height: 2rem;
    }

    .lg {
      width: 1.375rem;
      height: 1.375rem;
    }

    .sm .bar,
    .lg .bar {
      width: 0.5rem;
    }
  }
</style>

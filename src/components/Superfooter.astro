---
import c from '../content/superfooter.json';
---

<section class="superfooter" aria-label="Dataset overview">
  <div class="col col-precis">
    {c.precis.map(line => <p>{line}</p>)}
  </div>

  <ul class="col" role="list">
    {c.stats.map(line => <li>{line}</li>)}
  </ul>

  <ul class="col" role="list">
    {c.species.map(line => <li>{line}</li>)}
  </ul>

  <ul class="col" role="list">
    {c.streets.map(line => <li>{line}</li>)}
  </ul>
</section>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .superfooter {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding: 3rem var(--gutter);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .col {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .col p,
  .col li {
    margin: 0;
    color: var(--charred);
  }

  .col-precis p {
    color: var(--forest);
    font-weight: 700;
  }

  @include medium {
    .superfooter {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
  }

  @include small {
    .superfooter {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>

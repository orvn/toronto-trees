---
const { label, class: className, hidden = false } = Astro.props;
---

<span class:list={['throbber', className]} role="status" aria-live="polite" aria-label={label} hidden={hidden}></span>

<style>
  .throbber {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border: 1.5px solid rgb(27 31 26 / 0.12);
    border-top-color: var(--forest);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  .throbber[hidden] {
    display: none;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

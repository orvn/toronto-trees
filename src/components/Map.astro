---
import { loadFragment } from '../lib/content';

const copy = loadFragment<{ geolocate_label: string; geolocate_out_of_bounds: string }>('map');
---

<div class="map-wrap">
  <div
    id="map"
    class="map"
    aria-label="Map of Toronto street trees"
    data-geolocate-label={copy.geolocate_label}
  >
    <div class="map-loading" aria-hidden="true">
      <span class="compass-loader"></span>
    </div>
    <p class="map-notice" role="status" aria-live="polite">{copy.geolocate_out_of_bounds}</p>
  </div>
</div>

<script>
  import * as maplibregl from 'maplibre-gl';
  import { Protocol } from 'pmtiles';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import cfg from '../content/map-style.json';
  import growthFactors from '../content/growth-factors.json';

  const pmtilesHref = import.meta.env.PUBLIC_PMTILES_URL || '/data/street-trees.pmtiles';
  (cfg.sources as any).trees.url = `pmtiles://${pmtilesHref}`;

  // Keys are lowercase; readBotanical() normalises the inventory's casing and misspellings
  const GENUS_COLOR_VAR: Record<string, string> = {
    acer: '--celery',
    gleditsia: '--golden',
    picea: '--rope',
    pinus: '--rope',
    quercus: '--killarney',
    tilia: '--golden',
    ulmus: '--asparagus',
    gymnocladus: '--spectra',
    malus: '--punch',
    syringa: '--lavender',
    ginkgo: '--raj',
    celtis: '--killarney',
    betula: '--geyser',
    amelanchier: '--casablanca',
    aesculus: '--killarney',
    pyrus: '--raj',
    prunus: '--blush',
    fraxinus: '--terracotta',
    platanus: '--gumleaf',
    thuja: '--killarney',
    liriodendron: '--asparagus',
    catalpa: '--lavender',
    morus: '--lavender',
    fagus: '--rope',
    sorbus: '--pomegranate',
    magnolia: '--zinnwaldite',
    juglans: '--kabul',
    ailanthus: '--pomegranate',
  };
  const cssVarValue = (name: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  const GROWTH_FACTOR: Record<string, number> = Object.fromEntries(
    Object.entries(growthFactors as Record<string, number>).map(([k, v]) => [k.toLowerCase(), v])
  );

  // The City's inventory misspells three genera and stores 'None' where a name is missing
  const GENUS_FIX: Record<string, string> = {
    alix: 'salix',           // 101 weeping willows
    allianthus: 'ailanthus', // tree of heaven
    crategus: 'crataegus',   // 2 Crusade hawthorns
  };

  // Genus is capitalised, species epithet left lowercase, per botanical convention
  function readBotanical(raw: unknown) {
    const name = String(raw ?? '').trim();
    if (!name || name === 'None') return { display: '', genus: '' };
    const [first, ...rest] = name.split(/\s+/);
    const genus = GENUS_FIX[first.toLowerCase()] ?? first.toLowerCase();
    const display = [genus.charAt(0).toUpperCase() + genus.slice(1), ...rest].join(' ');
    return { display, genus };
  }

  // Storage is unavailable in some private-browsing modes, so never let it throw
  const GEOLOCATE_USED_KEY = 'tt:geolocate-used';

  const readFlag = (key: string) => {
    try { return localStorage.getItem(key) === '1'; } catch { return false; }
  };

  const writeFlag = (key: string) => {
    try { localStorage.setItem(key, '1'); } catch { /* ignore */ }
  };

  const readCommon = (raw: unknown) => {
    const name = String(raw ?? '').trim();
    return !name || name === 'None' ? 'Tree' : name;
  };

  const GENUS_ICON: Record<string, string> = {
    acer: 'maple',
    gleditsia: 'locust',
    picea: 'spruce-pine',
    pinus: 'spruce-pine',
    quercus: 'oak',
    tilia: 'linden',
    ulmus: 'elm',
    gymnocladus: 'kentucky-coffeetree',
    malus: 'apple',
    syringa: 'lilac',
    ginkgo: 'ginkgo',
    celtis: 'hackberry',
    betula: 'birch',
    amelanchier: 'serviceberry',
    aesculus: 'horse-chestnut',
    pyrus: 'ornamental-pear',
    prunus: 'cherry',
    fraxinus: 'ash',
    platanus: 'sycamore',
    thuja: 'cedar',
    liriodendron: 'tulip-tree',
    catalpa: 'catalpa',
    morus: 'mulberry',
    fagus: 'beech',
    sorbus: 'rowan',
    magnolia: 'magnolia',
    juglans: 'walnut',
    ailanthus: 'tree-of-heaven',
  };

  // Worker and shared module copied to /vendor/maplibre so client resolves the worker `./maplibre-gl-shared.mjs` import
  maplibregl.setWorkerUrl('/vendor/maplibre/maplibre-gl-worker.mjs');

  if (!(window as any).__pmtilesRegistered) {
    maplibregl.addProtocol('pmtiles', new Protocol().tile);
    (window as any).__pmtilesRegistered = true;
  }

  let currentMap: maplibregl.Map | null = null;

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // Double-init guard
    if ((container as any).__mapInstance) return;

    // Overriding the UI string keeps the tooltip and accessible name matching the visible label
    const geolocateLabel = container.dataset.geolocateLabel || '';

    const map = new maplibregl.Map({
      container,
      locale: geolocateLabel ? { 'GeolocateControl.FindMyLocation': geolocateLabel } : undefined,
      style: cfg.basemap,
      center: cfg.center as [number, number],
      zoom: cfg.zoom,
      minZoom: cfg.minZoom,
      maxZoom: cfg.maxZoom,
      maxBounds: cfg.maxBounds as [[number, number], [number, number]],
      attributionControl: false,
    });

    (container as any).__mapInstance = map;
    currentMap = map;

    // Geolocation control
    const geolocate = new maplibregl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true, timeout: 10000 },
      trackUserLocation: false,
      showUserLocation: true,
      showAccuracyCircle: true,
      fitBoundsOptions: { maxZoom: cfg.locateMaxZoom },
    });
    map.addControl(geolocate, 'top-right');

    // MapLibre fits the accuracy circle to the viewport, so a coarse fix on a narrow
    // phone screen lands at or below the starting zoom and reads as no movement at all
    geolocate.on('geolocate', (e: any) => {
      const { longitude, latitude, accuracy } = e.coords;
      const bounds = maplibregl.LngLatBounds.fromLngLat(
        new maplibregl.LngLat(longitude, latitude),
        accuracy
      );
      const fitted = map.cameraForBounds(bounds, { maxZoom: cfg.locateMaxZoom })?.zoom;
      map.easeTo({
        center: [longitude, latitude],
        zoom: Math.max(fitted ?? cfg.locateMinZoom, cfg.locateMinZoom),
      });
    });

    const geoButton = container.querySelector('.maplibregl-ctrl-geolocate');
    if (geoButton && geolocateLabel) {
      const label = document.createElement('span');
      label.className = 'geolocate-label';
      label.textContent = geolocateLabel;
      geoButton.appendChild(label);

      // Icon collapses once used
      if (readFlag(GEOLOCATE_USED_KEY)) geoButton.classList.add('is-collapsed');
      geoButton.addEventListener('click', () => {
        geoButton.classList.add('is-collapsed');
        writeFlag(GEOLOCATE_USED_KEY);
      });
    }

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    // Fired when the geolocate lands outside maxBounds
    const notice = container.querySelector('.map-notice');
    let noticeTimer: ReturnType<typeof setTimeout>;
    geolocate.on('outofmaxbounds', () => {
      if (!notice) return;
      notice.classList.add('is-visible');
      clearTimeout(noticeTimer);
      noticeTimer = setTimeout(() => notice.classList.remove('is-visible'), 6000);
    });

    map.once('idle', () => container.classList.add('is-loaded'));

    map.on('load', () => {
      for (const [id, src] of Object.entries(cfg.sources)) {
        map.addSource(id, src as any);
      }
      for (const layer of cfg.layers as any[]) {
        map.addLayer(layer);
      }

      map.on('click', 'trees-circles', (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties ?? {};

        const wrap = document.createElement('div');
        wrap.className = 'tree-popup';

        const { display: botanicalName, genus: genusKey } = readBotanical(p.BOTANICAL_NAME);
        const iconName = GENUS_ICON[genusKey] || 'other';

        const common = document.createElement('p');
        common.className = 'tp-common';

        const leaf = document.createElement('img');
        leaf.className = 'tp-leaf';
        leaf.src = `/icons/leaves/${iconName}.png`;
        leaf.alt = '';
        leaf.width = 24;
        leaf.height = 24;
        common.appendChild(leaf);
        common.appendChild(document.createTextNode(readCommon(p.COMMON_NAME)));
        wrap.appendChild(common);

        if (botanicalName) {
          const chipWrap = document.createElement('div');
          chipWrap.className = 'tp-botanical-wrap';
          const em = document.createElement('span');
          em.className = 'tp-botanical';
          em.textContent = botanicalName;
          const cssVar = GENUS_COLOR_VAR[genusKey] || '--bombay';
          em.style.setProperty('--tp-color', cssVarValue(cssVar));
          chipWrap.appendChild(em);
          wrap.appendChild(chipWrap);
        }

        const addr = [p.ADDRESS, p.STREETNAME].filter(Boolean).join(' ');
        if (addr) {
          const a = document.createElement('p');
          a.className = 'tp-meta';
          a.textContent = addr;
          wrap.appendChild(a);
        }

        if (p.DBH_TRUNK != null) {
          const d = document.createElement('p');
          d.className = 'tp-meta';
          d.textContent = `Trunk Ø ${p.DBH_TRUNK} cm`;
          wrap.appendChild(d);

          const botanical = botanicalName.toLowerCase();
          const parts = botanical.split(/\s+/).filter(w => w !== 'x' && w !== '×');
          const speciesKey = parts.length >= 2 ? `${parts[0]} ${parts[1]}` : '';
          const factor =
            GROWTH_FACTOR[botanical] ??
            (speciesKey ? GROWTH_FACTOR[speciesKey] : undefined) ??
            GROWTH_FACTOR[genusKey] ??
            GROWTH_FACTOR._default;

          if (factor && p.DBH_TRUNK > 0) {
            const years = Math.max(1, Math.round((Number(p.DBH_TRUNK) / 2.54) * factor));
            const age = document.createElement('p');
            age.className = 'tp-meta tp-age';
            age.textContent = `~${years} years old`;
            age.title = 'Rough estimate from trunk diameter × ISA growth factor for this species';
            wrap.appendChild(age);
          }
        }

        new maplibregl.Popup({ closeButton: true, maxWidth: '260px', className: 'tp' })
          .setLngLat(e.lngLat)
          .setDOMContent(wrap)
          .addTo(map);
      });

      map.on('mouseenter', 'trees-circles', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'trees-circles', () => { map.getCanvas().style.cursor = ''; });
    });
  }

  function destroyMap() {
    if (currentMap) {
      currentMap.remove();
      currentMap = null;
    }
  }

  // Fires on load and every ClientRouter navigation
  document.addEventListener('astro:page-load', initMap);
  // Fires before the new page swaps in
  document.addEventListener('astro:before-swap', destroyMap);
</script>

<style lang="scss">
  .map-wrap {
    padding-inline: var(--gutter);
    padding-top: 1.5rem;
  }

  .map {
    position: relative;
    width: 100%;
    height: min(70vh, 42rem);
    background: var(--cararra);
  }

  .map-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cararra);
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .map.is-loaded .map-loading {
    opacity: 0;
  }

  .map-notice {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    max-width: min(22rem, calc(100% - 2rem));
    margin: 0;
    padding: 0.55rem 0.9rem;
    background: var(--cararra);
    color: var(--charred);
    border: 1px solid rgb(27 31 26 / 0.1);
    border-radius: 0.35rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  .map-notice.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .compass-loader {
    --color-1: color-mix(in srgb, var(--forest) 14%, white);
    --color-2: var(--forest);
    --size: 0.75px;

    width: calc(64 * var(--size));
    height: calc(64 * var(--size));
    position: relative;
    background: var(--color-1);
    border-radius: 50%;
    transform: rotate(45deg);
    animation: compass-spin 2s linear infinite;
  }

  .compass-loader::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(15 * var(--size));
    height: calc(30 * var(--size));
    background: var(--color-2);
    transform: skew(5deg, 60deg) translate(-50%, -5%);
  }

  .compass-loader::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(6 * var(--size));
    height: calc(6 * var(--size));
    border-radius: 50%;
    background: var(--color-1);
    transform: translate(-50%, -50%);
  }

  @keyframes compass-spin {
    0%                 { transform: rotate(45deg); }
    30%, 50%, 70%      { transform: rotate(230deg); }
    40%, 60%, 80%      { transform: rotate(240deg); }
    100%               { transform: rotate(245deg); }
  }

  :global(.maplibregl-ctrl-group button.maplibregl-ctrl-geolocate) {
    display: flex;
    align-items: center;
    width: auto;
    gap: 0.3rem;
    padding-right: 0.7rem;
    transition: gap 200ms ease, padding-right 200ms ease;
  }

  :global(.maplibregl-ctrl-group button.maplibregl-ctrl-geolocate .maplibregl-ctrl-icon) {
    width: 1.8125rem;
    flex-shrink: 0;
  }

  :global(.geolocate-label) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1;
    color: var(--charred);
    white-space: nowrap;
    max-width: 10rem;
    overflow: hidden;
    transition: max-width 200ms ease, opacity 150ms ease;
  }

  /* Collapses to the bare icon once the feature has been used.
     Must out-specify the button rule above, which carries an element selector */
  :global(.maplibregl-ctrl-group button.maplibregl-ctrl-geolocate.is-collapsed) {
    gap: 0;
    padding-right: 0;
  }

  :global(.maplibregl-ctrl-geolocate.is-collapsed .geolocate-label) {
    max-width: 0;
    opacity: 0;
  }

  :global(.maplibregl-ctrl button:disabled .geolocate-label) {
    opacity: 0.25;
  }

  /* Scoped under .maplibregl-map to outrank maplibre-gl.css, which loads after this */
  :global(.maplibregl-map .maplibregl-user-location-dot),
  :global(.maplibregl-map .maplibregl-user-location-dot::before) {
    width: 1rem;
    height: 1rem;
  }

  :global(.maplibregl-map .maplibregl-user-location-dot::after) {
    width: 1.375rem;
    height: 1.375rem;
    top: -0.1875rem;
    left: -0.1875rem;
    border-width: 0.1875rem;
    box-shadow: 0 0.125rem 0.5rem rgb(0 0 0 / 0.35);
  }

  :global(.tp .maplibregl-popup-content) {
    background: var(--cararra);
    color: var(--charred);
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid rgb(27 31 26 / 0.1);
    border-radius: 0.35rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    font-size: var(--text-sm);
    line-height: 1.4;
    min-width: 12rem;
  }

  :global(.tp.maplibregl-popup-anchor-top     .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-top-left  .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-top-right .maplibregl-popup-tip) {
    border-bottom-color: var(--cararra);
  }
  :global(.tp.maplibregl-popup-anchor-bottom     .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-bottom-left  .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip) {
    border-top-color: var(--cararra);
  }
  :global(.tp.maplibregl-popup-anchor-left  .maplibregl-popup-tip) { border-right-color: var(--cararra); }
  :global(.tp.maplibregl-popup-anchor-right .maplibregl-popup-tip) { border-left-color:  var(--cararra); }

  :global(.tree-popup p) { margin: 0; }

  :global(.tp-common) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.2;
    color: var(--charred);
    margin-bottom: 0.35rem !important;
  }

  :global(.tp-leaf) {
    height: 2.25rem;
    width: auto;
    flex-shrink: 0;
    display: block;
    margin-top: 0.05rem;
  }

  :global(.tp-botanical-wrap) {
    margin-bottom: 0.6rem;
  }

  :global(.tp-botanical) {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--tp-color, var(--forest)) 18%, transparent);
    border: 1px solid color-mix(in srgb, var(--tp-color, var(--forest)) 55%, transparent);
    color: color-mix(in srgb, var(--tp-color, var(--forest)) 55%, black);
    font-style: italic;
    font-size: 0.9em;
    line-height: 1.25;
  }

  :global(.tp-meta) {
    color: var(--battleship);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  :global(.tp .maplibregl-popup-close-button) {
    color: var(--battleship);
    font-size: 1.1rem;
    padding: 0.1rem 0.45rem;
    line-height: 1;
  }
  :global(.tp .maplibregl-popup-close-button:hover) {
    color: var(--charred);
    background: transparent;
  }
</style>

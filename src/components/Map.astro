---
import { loadFragment } from '../lib/content';

const copy = loadFragment<{ geolocate_label: string; geolocate_out_of_bounds: string }>('map');
---

<div class="map-wrap">
  <div
    id="map"
    class="map"
    aria-label="Map of Toronto street trees"
    data-geolocate-label={copy.geolocate_label}
  >
    <div class="map-loading" aria-hidden="true">
      <span class="compass-loader"></span>
    </div>
    <p class="map-notice" role="status" aria-live="polite">{copy.geolocate_out_of_bounds}</p>
  </div>
</div>

<script>
  import * as maplibregl from 'maplibre-gl';
  import { Protocol } from 'pmtiles';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import cfg from '../content/map-style.json';
  import growthFactors from '../content/growth-factors.json';
  import { GENUS_COLOR_VAR, GENUS_ICON, GENUS_FIX, readBotanical, readCommon } from '../lib/botanical';
  import { readViewParams, writeViewParams, readSpotlightParam, writeSpotlightParam } from '../lib/params';

  const pmtilesHref = import.meta.env.PUBLIC_PMTILES_URL || '/data/street-trees.pmtiles';
  (cfg.sources as any).trees.url = `pmtiles://${pmtilesHref}`;

  const cssVarValue = (name: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim();

  const GROWTH_FACTOR: Record<string, number> = Object.fromEntries(
    Object.entries(growthFactors as Record<string, number>).map(([k, v]) => [k.toLowerCase(), v])
  );

  // Lookup order: exact botanical name, genus + species, genus, then the default
  const growthFactorFor = (botanicalDisplay: string, genus: string) => {
    const botanical = botanicalDisplay.toLowerCase();
    const parts = botanical.split(/\s+/).filter(w => w !== 'x' && w !== '×');
    const speciesKey = parts.length >= 2 ? `${parts[0]} ${parts[1]}` : '';
    return (
      GROWTH_FACTOR[botanical] ??
      (speciesKey ? GROWTH_FACTOR[speciesKey] : undefined) ??
      GROWTH_FACTOR[genus] ??
      GROWTH_FACTOR._default
    );
  };

  const estimateAge = (p: Record<string, any>) => {
    const dbh = Number(p.DBH_TRUNK);
    if (!(dbh > 0)) return 0;
    const { display, genus } = readBotanical(p.BOTANICAL_NAME);
    return Math.max(1, Math.round((dbh / 2.54) * growthFactorFor(display, genus)));
  };

  // Storage is unavailable in some private-browsing modes, so never let it throw
  const GEOLOCATE_USED_KEY = 'tt:geolocate-used';

  const readFlag = (key: string) => {
    try { return localStorage.getItem(key) === '1'; } catch { return false; }
  };

  const writeFlag = (key: string) => {
    try { localStorage.setItem(key, '1'); } catch { /* ignore */ }
  };

  // Worker and shared module copied to /vendor/maplibre so client resolves the worker `./maplibre-gl-shared.mjs` import
  maplibregl.setWorkerUrl('/vendor/maplibre/maplibre-gl-worker.mjs');

  if (!(window as any).__pmtilesRegistered) {
    maplibregl.addProtocol('pmtiles', new Protocol().tile);
    (window as any).__pmtilesRegistered = true;
  }

  let currentMap: maplibregl.Map | null = null;
  let filterHandler: ((e: Event) => void) | null = null;
  let locateHandler: ((e: Event) => void) | null = null;
  let rangeHandler: ((e: Event) => void) | null = null;

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // Double-init guard
    if ((container as any).__mapInstance) return;

    // Overriding the UI string keeps the tooltip and accessible name matching the visible label
    const geolocateLabel = container.dataset.geolocateLabel || '';

    const view = readViewParams();

    const map = new maplibregl.Map({
      container,
      locale: geolocateLabel ? { 'GeolocateControl.FindMyLocation': geolocateLabel } : undefined,
      style: cfg.basemap,
      center: view.center ?? (cfg.center as [number, number]),
      zoom: view.zoom ?? cfg.zoom,
      minZoom: cfg.minZoom,
      maxZoom: cfg.maxZoom,
      maxBounds: cfg.maxBounds as [[number, number], [number, number]],
      attributionControl: false,
    });

    (container as any).__mapInstance = map;
    currentMap = map;

    map.on('moveend', () => writeViewParams(map));

    // Geolocation control
    const geolocate = new maplibregl.GeolocateControl({
      positionOptions: { enableHighAccuracy: true, timeout: 10000 },
      trackUserLocation: false,
      showUserLocation: true,
      showAccuracyCircle: true,
      fitBoundsOptions: { maxZoom: cfg.locateMaxZoom },
    });
    map.addControl(geolocate, 'top-right');

    // Cap on radius of accuracy circle
    const capAccuracyCircle = (longitude: number, latitude: number) => {
      const circle = container.querySelector<HTMLElement>(
        '.maplibregl-user-location-accuracy-circle'
      );
      if (!circle) return;
      const centre = new maplibregl.LngLat(longitude, latitude);
      const origin = map.project(centre);
      const metresPerPixel = centre.distanceTo(map.unproject([origin.x + 100, origin.y])) / 100;
      const diameter = (2 * cfg.locateMaxAccuracy) / metresPerPixel;
      (geolocate as any)._accuracy = cfg.locateMaxAccuracy;
      circle.style.width = `${diameter.toFixed(2)}px`;
      circle.style.height = `${diameter.toFixed(2)}px`;
    };

    // MapLibre fits the accuracy circle to the viewport, so a coarse fix on a narrow
    // phone screen lands at or below the starting zoom and reads as no movement at all
    geolocate.on('geolocate', (e: any) => {
      const { longitude, latitude, accuracy } = e.coords;
      const bounds = maplibregl.LngLatBounds.fromLngLat(
        new maplibregl.LngLat(longitude, latitude),
        accuracy
      );
      const fitted = map.cameraForBounds(bounds, { maxZoom: cfg.locateMaxZoom })?.zoom;
      map.easeTo({
        center: [longitude, latitude],
        zoom: Math.max(fitted ?? cfg.locateMinZoom, cfg.locateMinZoom),
      });

      // Shown at true size while the camera moves, then eased down once it settles, MapLibre rewrites the element every frame during the ease, so this has to wait
      if (accuracy > cfg.locateMaxAccuracy) {
        setTimeout(() => capAccuracyCircle(longitude, latitude), 700);
      }
    });

    const geoButton = container.querySelector('.maplibregl-ctrl-geolocate');
    if (geoButton && geolocateLabel) {
      const label = document.createElement('span');
      label.className = 'geolocate-label';
      label.textContent = geolocateLabel;
      geoButton.appendChild(label);

      // Icon collapses once used
      if (readFlag(GEOLOCATE_USED_KEY)) geoButton.classList.add('is-collapsed');
      geoButton.addEventListener('click', () => {
        geoButton.classList.add('is-collapsed');
        writeFlag(GEOLOCATE_USED_KEY);
      });
    }

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    // Fired when the geolocate lands outside maxBounds
    const notice = container.querySelector('.map-notice');
    let noticeTimer: ReturnType<typeof setTimeout>;
    geolocate.on('outofmaxbounds', () => {
      if (!notice) return;
      notice.classList.add('is-visible');
      clearTimeout(noticeTimer);
      noticeTimer = setTimeout(() => notice.classList.remove('is-visible'), 6000);
    });

    map.once('idle', () => container.classList.add('is-loaded'));

    map.on('load', () => {
      for (const [id, src] of Object.entries(cfg.sources)) {
        map.addSource(id, src as any);
      }
      for (const layer of cfg.layers as any[]) {
        map.addLayer(layer);
      }

      const circles = (cfg.layers as any[]).find(l => l.id === 'trees-circles');
      const scaleStops = (base: any[], k: number) =>
        base.map((v, i) => (i >= 3 && i % 2 === 0 ? Math.min(1, v * k) : v));
      map.addLayer(
        {
          id: 'trees-circles-halo',
          type: 'circle',
          source: circles.source,
          'source-layer': circles['source-layer'],
          minzoom: circles.minzoom,
          paint: {
            'circle-radius': circles.paint['circle-radius'],
            'circle-opacity': 0,
            'circle-stroke-width': circles.paint['circle-stroke-width'],
            'circle-stroke-color': circles.paint['circle-color'],
            'circle-stroke-opacity': scaleStops(circles.paint['circle-opacity'], cfg.haloOpacity),
          },
        },
        'trees-circles'
      ); // Halo opacity is proportional to zoom level

      // Legend filtering
      const rawAliases: Record<string, string[]> = {};
      for (const [raw, fixed] of Object.entries(GENUS_FIX)) {
        (rawAliases[fixed] ||= []).push(raw);
      }
      const spellings = (genus: string) => [genus, ...(rawAliases[genus] || [])];

      const iconGenera: Record<string, string[]> = {};
      for (const [genus, icon] of Object.entries(GENUS_ICON)) {
        (iconGenera[icon] ||= []).push(...spellings(genus));
      }
      const namedGenera = Object.keys(GENUS_ICON).flatMap(spellings);

      const nameExpr = ['downcase', ['coalesce', ['get', 'BOTANICAL_NAME'], '']];
      const dbhExpr = ['to-number', ['get', 'DBH_TRUNK']];

      // estimateAge() for the GPU: most specific growth-factor key first, each matched as a name prefix.
      // The inventory's misspelt genera get their own keys so they pick up the right factor
      const factorEntries = Object.entries(GROWTH_FACTOR).filter(([k, v]) => k !== '_default' && typeof v === 'number');
      for (const [raw, fixed] of Object.entries(GENUS_FIX)) {
        for (const [k, v] of [...factorEntries]) {
          if (k.startsWith(fixed)) factorEntries.push([raw + k.slice(fixed.length), v]);
        }
      }
      factorEntries.sort((a, b) => b[0].split(' ').length - a[0].split(' ').length || b[0].length - a[0].length);
      const ageExpr = [
        'round',
        ['*', ['/', dbhExpr, 2.54],
          ['case', ...factorEntries.flatMap(([k, v]) => [['==', ['index-of', k, nameExpr], 0], v]), GROWTH_FACTOR._default]],
      ];
      const isGenus = (g: string) => ['==', ['index-of', g, nameExpr], 0];
      const matchFor = (icon: string) =>
        icon === 'other'
          ? ['!', ['any', ...namedGenera.map(isGenus)]]
          : ['any', ...(iconGenera[icon] || []).map(isGenus)];

      // Zoom may only drive a top-level interpolate, so the dimming goes inside each stop
      const dimStops = (base: any[], match: any[], faded: number) => {
        const out = base.slice(0, 3);
        for (let i = 3; i < base.length; i += 2) {
          out.push(base[i], ['case', match, base[i + 1], faded]);
        }
        return out;
      };

      const paintOf = (id: string, prop: string) =>
        (cfg.layers as any[]).find(l => l.id === id).paint[prop];
      const baseCircle = paintOf('trees-circles', 'circle-opacity');
      const baseHeat = paintOf('trees-heatmap', 'heatmap-opacity');
      const baseStrokeWidth = paintOf('trees-circles', 'circle-stroke-width');
      const baseStrokeColor = paintOf('trees-circles', 'circle-stroke-color');
      const baseHaloOpacity = scaleStops(baseCircle, cfg.haloOpacity);

      const selectedStroke = (match: any[]) => [
        'interpolate', ['linear'], ['zoom'],
        9, ['case', match, 0.8, 0],
        13, ['case', match, 1, 0],
        16, ['case', match, 1.4, 0],
      ];

      const iconColorVar: Record<string, string> = { other: '--bombay' };
      for (const [genus, icon] of Object.entries(GENUS_ICON)) {
        iconColorVar[icon] ||= GENUS_COLOR_VAR[genus];
      }

      // Sits above the basemap but below the trees, so the wash never mutes the selection
      map.addLayer(
        {
          id: 'genus-tint',
          type: 'background',
          paint: { 'background-color': cssVarValue('--bombay'), 'background-opacity': 0 },
        },
        'trees-heatmap'
      );

      // Species comes from the legend or the search bar; ranges come from the sliders. Both dim what they exclude
      let speciesMatch: any[] | null = null;
      let rangeMatch: any[] | null = null;
      let speciesTest: ((raw: unknown) => boolean) | null = null;
      let rangeTest: ((p: Record<string, any>) => boolean) | null = null;
      let tintVar = '--bombay';
      const iconOf = (raw: unknown) => GENUS_ICON[readBotanical(raw).genus] || 'other';
      const isSelectable = (p: Record<string, any>) =>
        (speciesTest === null || speciesTest(p.BOTANICAL_NAME)) && (rangeTest === null || rangeTest(p));

      const applyFilters = () => {
        const match = speciesMatch && rangeMatch ? ['all', speciesMatch, rangeMatch] : speciesMatch ?? rangeMatch;

        map.setPaintProperty(
          'trees-circles',
          'circle-opacity',
          match ? dimStops(baseCircle, match, 0.15) : baseCircle
        );
        for (const id of ['trees-circles', 'trees-circles-halo']) {
          map.setPaintProperty(
            id,
            'circle-stroke-width',
            match ? selectedStroke(match) : baseStrokeWidth
          );
        }
        // When filtering, halo stays dark as a cue
        map.setPaintProperty(
          'trees-circles-halo',
          'circle-stroke-opacity',
          match ? 1 : baseHaloOpacity
        );
        map.setPaintProperty(
          'trees-circles',
          'circle-stroke-color',
          match ? cfg.filterStrokeColor : baseStrokeColor
        );

        // The heatmap covers every tree, so it would drown out a selection
        map.setPaintProperty('trees-heatmap', 'heatmap-opacity', match ? 0 : baseHeat);

        if (speciesMatch) {
          map.setPaintProperty('genus-tint', 'background-color', cssVarValue(tintVar));
        }
        map.setPaintProperty('genus-tint', 'background-opacity', speciesMatch ? cfg.tintOpacity : 0);
      };

      filterHandler = (e: Event) => {
        const { icon = null, genus = null, botanical = null } = (e as CustomEvent).detail ?? {};
        if (botanical) {
          const wanted = String(botanical).trim().toLowerCase();
          speciesMatch = ['==', nameExpr, wanted];
          tintVar = GENUS_COLOR_VAR[readBotanical(botanical).genus] || '--bombay';
          speciesTest = raw => String(raw ?? '').trim().toLowerCase() === wanted;
        } else if (genus) {
          speciesMatch = ['any', ...spellings(genus).map(isGenus)];
          tintVar = GENUS_COLOR_VAR[genus] || '--bombay';
          speciesTest = raw => readBotanical(raw).genus === genus;
        } else if (icon) {
          speciesMatch = matchFor(icon);
          tintVar = iconColorVar[icon];
          speciesTest = raw => iconOf(raw) === icon;
        } else {
          speciesMatch = null;
          speciesTest = null;
        }
        applyFilters();
      };
      document.addEventListener('tt:genus-filter', filterHandler);

      rangeHandler = (e: Event) => {
        const { ageMin = null, ageMax = null, dbhMin = null, dbhMax = null } = (e as CustomEvent).detail ?? {};
        const parts: any[] = [];
        if (ageMin !== null) parts.push(['>=', ageExpr, ageMin]);
        if (ageMax !== null) parts.push(['<=', ageExpr, ageMax]);
        if (dbhMin !== null) parts.push(['>=', dbhExpr, dbhMin]);
        if (dbhMax !== null) parts.push(['<=', dbhExpr, dbhMax]);
        rangeMatch = parts.length ? ['all', ...parts] : null;
        rangeTest = parts.length
          ? p => {
              const age = estimateAge(p);
              const dbh = Number(p.DBH_TRUNK) || 0;
              return (
                (ageMin === null || age >= ageMin) &&
                (ageMax === null || age <= ageMax) &&
                (dbhMin === null || dbh >= dbhMin) &&
                (dbhMax === null || dbh <= dbhMax)
              );
            }
          : null;
        applyFilters();
      };
      document.addEventListener('tt:range-filter', rangeHandler);

      // Which tile source and id property each key prefix resolves to
      const TREE_SOURCES: Record<string, { source: string; sourceLayer: string; idProp: string }> = {
        t: { source: circles.source, sourceLayer: circles['source-layer'], idProp: 'OBJECTID' },
      };
      const treeKey = (prefix: string, p: Record<string, any>) => {
        const id = Number(p[TREE_SOURCES[prefix].idProp]);
        return Number.isInteger(id) && id > 0 ? `${prefix}${id}` : null;
      };

      let currentPopup: maplibregl.Popup | null = null;

      const openTreePopup = (p: Record<string, any>, lngLat: [number, number]) => {
        currentPopup?.remove();

        const wrap = document.createElement('div');
        wrap.className = 'tree-popup';

        const { display: botanicalName, genus: genusKey } = readBotanical(p.BOTANICAL_NAME);
        const iconName = GENUS_ICON[genusKey] || 'other';

        const common = document.createElement('p');
        common.className = 'tp-common';

        const leaf = document.createElement('img');
        leaf.className = 'tp-leaf';
        leaf.src = `/icons/leaves/${iconName}.png`;
        leaf.alt = '';
        leaf.width = 24;
        leaf.height = 24;
        common.appendChild(leaf);
        common.appendChild(document.createTextNode(readCommon(p.COMMON_NAME)));
        wrap.appendChild(common);

        if (botanicalName) {
          const chipWrap = document.createElement('div');
          chipWrap.className = 'tp-botanical-wrap';
          const em = document.createElement('span');
          em.className = 'tp-botanical';
          em.textContent = botanicalName;
          const cssVar = GENUS_COLOR_VAR[genusKey] || '--bombay';
          em.style.setProperty('--tp-color', cssVarValue(cssVar));
          chipWrap.appendChild(em);
          wrap.appendChild(chipWrap);
        }

        const addr = [p.ADDRESS, p.STREETNAME].filter(Boolean).join(' ');
        if (addr) {
          const a = document.createElement('p');
          a.className = 'tp-meta';
          a.textContent = addr;
          wrap.appendChild(a);
        }

        if (p.DBH_TRUNK != null) {
          const d = document.createElement('p');
          d.className = 'tp-meta';
          d.textContent = `Trunk Ø ${p.DBH_TRUNK} cm`;
          wrap.appendChild(d);

          const years = estimateAge(p);
          if (years) {
            const age = document.createElement('p');
            age.className = 'tp-meta tp-age';
            age.textContent = `~${years} years old`;
            age.title = 'Rough estimate from trunk diameter × ISA growth factor for this species';
            wrap.appendChild(age);
          }
        }

        const popup = new maplibregl.Popup({ closeButton: true, maxWidth: '260px', className: 'tp' })
          .setLngLat(lngLat)
          .setDOMContent(wrap)
          .addTo(map);
        currentPopup = popup;

        const key = treeKey('t', p);
        if (key) {
          writeViewParams(map);
          writeSpotlightParam(key);
          popup.on('close', () => {
            if (currentPopup === popup) {
              currentPopup = null;
              writeSpotlightParam(null);
            }
          });
        }
        return popup;
      };

      map.on('click', 'trees-circles', (e) => {
        const f = e.features?.find(x => isSelectable(x.properties ?? {}));
        if (f) openTreePopup(f.properties ?? {}, [e.lngLat.lng, e.lngLat.lat]);
      });

      // Address search: fit a whole street, or land near an interpolated house number and
      // then snap to the loaded tree whose number is closest
      locateHandler = (e: Event) => {
        const d = (e as CustomEvent).detail ?? {};
        const done = (found: boolean) =>
          document.dispatchEvent(new CustomEvent('tt:locate-done', { detail: { found } }));
        if (d.bounds) {
          map.fitBounds(d.bounds, { padding: 48, maxZoom: 16, duration: 900 });
          map.once('moveend', () => done(true));
          return;
        }
        map.flyTo({ center: [d.lng, d.lat], zoom: 15.5, duration: 1200 });
        map.once('idle', () => {
          const feats = map.querySourceFeatures('trees', {
            sourceLayer: 'trees',
            filter: ['==', ['get', 'STREETNAME'], d.street],
          });
          let best: (typeof feats)[number] | null = null;
          let bestGap = Infinity;
          for (const f of feats) {
            const gap = Math.abs(Number(f.properties?.ADDRESS) - d.address);
            if (gap < bestGap) { bestGap = gap; best = f; }
          }
          if (!best) return done(false);
          const g = best.geometry as any;
          const [lng, lat] = g.type === 'Point' ? g.coordinates : g.coordinates[0];
          map.easeTo({ center: [lng, lat], zoom: 17, duration: 700 });
          map.once('moveend', () => {
            openTreePopup(best!.properties ?? {}, [lng, lat]);
            done(true);
          });
        });
      };
      document.addEventListener('tt:locate', locateHandler);

      // Deep link: the tree is only findable once its tile has loaded, so wait for the first idle
      const spotlight = readSpotlightParam();
      const spotlightSrc = spotlight && TREE_SOURCES[spotlight.prefix];
      if (spotlight && spotlightSrc) {
        map.once('idle', () => {
          const [f] = map.querySourceFeatures(spotlightSrc.source, {
            sourceLayer: spotlightSrc.sourceLayer,
            filter: ['==', ['get', spotlightSrc.idProp], spotlight.id],
          });
          if (!f) return;
          const g = f.geometry as any;
          const coord = g.type === 'MultiPoint' ? g.coordinates[0] : g.coordinates;
          if (!coord) return;
          openTreePopup(f.properties ?? {}, coord as [number, number]);
        });
      }

      // mousemove rather than mouseenter, so the cursor tracks selectability within the layer
      map.on('mousemove', 'trees-circles', (e) => {
        const hit = e.features?.some(x => isSelectable(x.properties ?? {}));
        map.getCanvas().style.cursor = hit ? 'pointer' : '';
      });
      map.on('mouseleave', 'trees-circles', () => { map.getCanvas().style.cursor = ''; });
    });
  }

  function destroyMap() {
    if (filterHandler) {
      document.removeEventListener('tt:genus-filter', filterHandler);
      filterHandler = null;
    }
    if (locateHandler) {
      document.removeEventListener('tt:locate', locateHandler);
      locateHandler = null;
    }
    if (rangeHandler) {
      document.removeEventListener('tt:range-filter', rangeHandler);
      rangeHandler = null;
    }
    if (currentMap) {
      currentMap.remove();
      currentMap = null;
    }
  }

  // Fires on load and every ClientRouter navigation
  document.addEventListener('astro:page-load', initMap);
  // Fires before the new page swaps in
  document.addEventListener('astro:before-swap', destroyMap);
</script>

<style lang="scss">
  .map-wrap {
    padding-inline: var(--gutter);
    padding-top: 1.5rem;
  }

  .map {
    position: relative;
    width: 100%;
    height: min(70vh, 42rem);
    background: var(--cararra);
  }

  .map-loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cararra);
    pointer-events: none;
    transition: opacity 350ms ease;
  }

  .map.is-loaded .map-loading {
    opacity: 0;
  }

  .map-notice {
    position: absolute;
    z-index: 3;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    max-width: min(22rem, calc(100% - 2rem));
    margin: 0;
    padding: 0.55rem 0.9rem;
    background: var(--cararra);
    color: var(--charred);
    border: 1px solid rgb(27 31 26 / 0.1);
    border-radius: 0.35rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 200ms ease, visibility 200ms ease;
  }

  .map-notice.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .compass-loader {
    --color-1: color-mix(in srgb, var(--forest) 14%, white);
    --color-2: var(--forest);
    --size: 0.75px;

    width: calc(64 * var(--size));
    height: calc(64 * var(--size));
    position: relative;
    background: var(--color-1);
    border-radius: 50%;
    transform: rotate(45deg);
    animation: compass-spin 2s linear infinite;
  }

  .compass-loader::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(15 * var(--size));
    height: calc(30 * var(--size));
    background: var(--color-2);
    transform: skew(5deg, 60deg) translate(-50%, -5%);
  }

  .compass-loader::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(6 * var(--size));
    height: calc(6 * var(--size));
    border-radius: 50%;

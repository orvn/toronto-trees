---
import Legend from './Legend.astro';
---

<div class="map-wrap">
  <div id="map" class="map" aria-label="Map of Toronto street trees"></div>
  <div class="legend-slot">
    <Legend />
  </div>
</div>

<script>
  import * as maplibregl from 'maplibre-gl';
  import { Protocol } from 'pmtiles';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?url';
  import cfg from '../content/map-style.json';

  const pmtilesHref = import.meta.env.PUBLIC_PMTILES_URL || '/data/street-trees.pmtiles';
  (cfg.sources as any).trees.url = `pmtiles://${pmtilesHref}`;

  maplibregl.setWorkerUrl(workerUrl);

  if (!(window as any).__pmtilesRegistered) {
    maplibregl.addProtocol('pmtiles', new Protocol().tile);
    (window as any).__pmtilesRegistered = true;
  }

  let currentMap: maplibregl.Map | null = null;

  function initMap() {
    const container = document.getElementById('map');
    if (!container) return;

    // Double-init guard
    if ((container as any).__mapInstance) return;

    const map = new maplibregl.Map({
      container,
      style: cfg.basemap,
      center: cfg.center as [number, number],
      zoom: cfg.zoom,
      minZoom: cfg.minZoom,
      maxZoom: cfg.maxZoom,
      attributionControl: false,
    });

    (container as any).__mapInstance = map;
    currentMap = map;

    map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

    map.on('load', () => {
      for (const [id, src] of Object.entries(cfg.sources)) {
        map.addSource(id, src as any);
      }
      for (const layer of cfg.layers as any[]) {
        map.addLayer(layer);
      }

      map.on('click', 'trees-circles', (e) => {
        const f = e.features?.[0];
        if (!f) return;
        const p = f.properties ?? {};

        const wrap = document.createElement('div');
        wrap.className = 'tree-popup';

        const common = document.createElement('p');
        common.className = 'tp-common';
        common.textContent = p.COMMON_NAME || 'Tree';
        wrap.appendChild(common);

        if (p.BOTANICAL_NAME) {
          const em = document.createElement('p');
          em.className = 'tp-botanical';
          em.textContent = p.BOTANICAL_NAME;
          wrap.appendChild(em);
        }

        const addr = [p.ADDRESS, p.STREETNAME].filter(Boolean).join(' ');
        if (addr) {
          const a = document.createElement('p');
          a.className = 'tp-meta';
          a.textContent = addr;
          wrap.appendChild(a);
        }

        if (p.DBH_TRUNK != null) {
          const d = document.createElement('p');
          d.className = 'tp-meta';
          d.textContent = `Trunk Ø ${p.DBH_TRUNK} cm`;
          wrap.appendChild(d);
        }

        new maplibregl.Popup({ closeButton: true, maxWidth: '260px', className: 'tp' })
          .setLngLat(e.lngLat)
          .setDOMContent(wrap)
          .addTo(map);
      });

      map.on('mouseenter', 'trees-circles', () => { map.getCanvas().style.cursor = 'pointer'; });
      map.on('mouseleave', 'trees-circles', () => { map.getCanvas().style.cursor = ''; });
    });
  }

  function destroyMap() {
    if (currentMap) {
      currentMap.remove();
      currentMap = null;
    }
  }

  // Fires on load and every ClientRouter navigation
  document.addEventListener('astro:page-load', initMap);
  // Fires before the new page swaps in
  document.addEventListener('astro:before-swap', destroyMap);
</script>

<style lang="scss">
  .map-wrap {
    position: relative;
    padding-inline: var(--gutter);
  }

  .map {
    width: 100%;
    height: min(70vh, 42rem);
    background: var(--cararra);
    border-bottom: 1px solid var(--charred);
  }

  .legend-slot {
    position: absolute;
    left: clamp(2rem, 5vw, 4rem);
    bottom: 2rem;
    z-index: 2;
    pointer-events: auto;
  }

  @media (max-width: 40rem) {
    .legend-slot {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
    }
  }

  :global(.tp .maplibregl-popup-content) {
    background: var(--cararra);
    color: var(--charred);
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid rgb(27 31 26 / 0.1);
    border-radius: 0.35rem;
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.12);
    font-size: var(--text-sm);
    line-height: 1.4;
    min-width: 12rem;
  }

  :global(.tp.maplibregl-popup-anchor-top     .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-top-left  .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-top-right .maplibregl-popup-tip) {
    border-bottom-color: var(--cararra);
  }
  :global(.tp.maplibregl-popup-anchor-bottom     .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-bottom-left  .maplibregl-popup-tip),
  :global(.tp.maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip) {
    border-top-color: var(--cararra);
  }
  :global(.tp.maplibregl-popup-anchor-left  .maplibregl-popup-tip) { border-right-color: var(--cararra); }
  :global(.tp.maplibregl-popup-anchor-right .maplibregl-popup-tip) { border-left-color:  var(--cararra); }

  :global(.tree-popup p) { margin: 0; }

  :global(.tp-common) {
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--charred);
    margin-bottom: 0.1rem !important;
  }

  :global(.tp-botanical) {
    font-style: italic;
    color: var(--forest);
    margin-bottom: 0.5rem !important;
  }

  :global(.tp-meta) {
    color: var(--battleship);
    font-variant-numeric: tabular-nums;
  }

  :global(.tp .maplibregl-popup-close-button) {
    color: var(--battleship);
    font-size: 1.1rem;
    padding: 0.1rem 0.45rem;
    line-height: 1;
  }
  :global(.tp .maplibregl-popup-close-button:hover) {
    color: var(--charred);
    background: transparent;
  }
</style>

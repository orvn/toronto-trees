---
import { loadFragment } from '../lib/content';
import GithubIcon from './GithubIcon.astro';

const { credit, links } = loadFragment<{
  credit: string;
  links: { label: string; href: string; icon: string | null; aria_label: string | null }[];
}>('footer');
const icons = { github: GithubIcon };
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-card">
    <slot />
    <div class="footer-inner">
    <p class="footer-copy">{credit}</p>
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        {links.map(({ label, href, icon, aria_label }) => {
          const Icon = icon && icons[icon as keyof typeof icons];
          const external = href.startsWith('http');
          return (
            <li>
              <a
                href={href}
                aria-label={aria_label ?? undefined}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener' : undefined}
              >
                <span>{label}</span>
                {Icon && <Icon />}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  @use '../styles/panel' as *;

  .site-footer {
    --inset: 1.5rem;
    position: relative;
    isolation: isolate;
    margin-top: 0.5rem;
    padding: 2.5rem calc(var(--gutter) + var(--inset)) 3rem;
    background-color: var(--cararra);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 var(--gutter);
    z-index: -1;
    background: var(--gradient-forest);
    mask-image: var(--hatch);
  }

  .footer-card {
    @include panel;
  }

  .footer-card > :global(* + .footer-inner) {
    border-top: 1px solid var(--porcelain);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 1.75rem;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--battleship);
    margin: 0;
  }

  .footer-nav ul {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav li {
    display: flex;
  }

  .footer-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-sm);
    line-height: 1;

    :global(svg) {
      flex-shrink: 0;
      width: 1.15em;
      height: 1.15em;
    }
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--forest);
  }

  @include small {
    .site-footer {
      --inset: 0.75rem;
      padding-block: 1.5rem 2rem;
    }
  }
</style>

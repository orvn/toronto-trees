---
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <p class="footer-copy">
      Made with City of Toronto Open Data.
      <a
        class="gh-link"
        href="https://github.com/orvn/toronto-trees"
        target="_blank"
        rel="noopener"
        aria-label="Feedback on GitHub"
      >
        <span>Feedback</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.97.11-.76.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.28 1.2-3.09-.12-.29-.52-1.47.1-3.06 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.83 0c2.22-1.49 3.2-1.18 3.2-1.18.62 1.59.23 2.77.12 3.06.75.81 1.2 1.83 1.2 3.09 0 4.42-2.7 5.4-5.26 5.69.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>
    </p>
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--cararra);
    padding: 1.5rem var(--gutter);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--battleship);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .gh-link:hover {
    color: var(--forest);
  }

  .footer-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    font-size: var(--text-sm);
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--forest);
  }
</style>

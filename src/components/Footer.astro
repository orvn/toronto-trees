---
import GithubIcon from './GithubIcon.astro';
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <p class="footer-copy">
      Made with City of Toronto Open Data.
      <a
        class="gh-link"
        href="https://github.com/orvn/toronto-trees"
        target="_blank"
        rel="noopener"
        aria-label="Feedback on GitHub"
      >
        <span>Feedback</span>
        <GithubIcon />
      </a>
    </p>
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--cararra);
    padding: 1.5rem var(--gutter);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--battleship);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .gh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .gh-link:hover {
    color: var(--forest);
  }

  .footer-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    font-size: var(--text-sm);
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--forest);
  }
</style>

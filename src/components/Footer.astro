<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <p class="footer-copy">
      Made in Toronto with City of Toronto Open Data. Basemap &copy;
      <a href="https://openfreemap.org" rel="noopener">OpenFreeMap</a>,
      &copy; <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors.
    </p>
    <nav class="footer-nav" aria-label="Footer navigation">
      <ul role="list">
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--cararra);
    padding: 1.5rem var(--gutter);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-size: var(--text-sm);
    color: var(--battleship);
    margin: 0;
  }

  .footer-nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-nav a {
    font-size: var(--text-sm);
    color: var(--battleship);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-nav a:hover {
    color: var(--forest);
  }
</style>

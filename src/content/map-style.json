{
  "basemap": "https://tiles.openfreemap.org/styles/positron",
  "center": [-79.3832, 43.6532],
  "zoom": 12,
  "minZoom": 9,
  "maxZoom": 18,
  "maxBounds": [[-80.4, 43.25], [-78.4, 44.45]],
  "locateMaxZoom": 16,
  "locateMinZoom": 14,
  "tintOpacity": 0.1,
  "locateMaxAccuracy": 300,
  "haloOpacity": 1,
  "filterStrokeColor": "rgba(0,0,0,0.4)",
  "sources": {
    "trees": {
      "type": "vector",
      "url": "pmtiles:///data/street-trees.pmtiles",
      "attribution": "City of Toronto Open Data — Street Tree Data"
    }
  },
  "layers": [
    {
      "id": "trees-heatmap",
      "type": "heatmap",
      "source": "trees",
      "source-layer": "trees",
      "maxzoom": 15,
      "paint": {
        "heatmap-weight": 0.6,
        "heatmap-intensity": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 13, 1.2, 15, 1.5],
        "heatmap-color": [
          "interpolate", ["linear"], ["heatmap-density"],
          0,   "rgba(0,0,0,0)",
          0.2, "#e9edc9",
          0.4, "#ccd5ae",
          0.6, "#a7c957",
          0.8, "#6a994e",
          1,   "#386641"
        ],
        "heatmap-radius": ["interpolate", ["linear"], ["zoom"], 9, 2, 13, 22, 15, 38],
        "heatmap-opacity": ["interpolate", ["linear"], ["zoom"], 9, 0.75, 12, 0.6, 14, 0.4, 15, 0]
      }
    },
    {
      "id": "trees-circles",
      "type": "circle",
      "source": "trees",
      "source-layer": "trees",
      "minzoom": 9,
      "paint": {
        "circle-radius": [
          "interpolate", ["linear"], ["zoom"],
          9,  ["interpolate", ["linear"], ["coalesce", ["get", "DBH_TRUNK"], 5], 0, 0.4, 60, 1.2],
          11, ["interpolate", ["linear"], ["coalesce", ["get", "DBH_TRUNK"], 5], 0, 0.7, 60, 2.2],
          12, ["interpolate", ["linear"], ["coalesce", ["get", "DBH_TRUNK"], 5], 0, 1,   60, 4],
          14, ["interpolate", ["linear"], ["coalesce", ["get", "DBH_TRUNK"], 5], 0, 2,   60, 8],
          17, ["interpolate", ["linear"], ["coalesce", ["get", "DBH_TRUNK"], 5], 0, 4,   60, 18]
        ],
        "circle-color": [
          "let", "n", ["downcase", ["coalesce", ["get", "BOTANICAL_NAME"], ""]],
          [
            "case",

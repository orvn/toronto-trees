---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPage } from '../lib/content';

const { meta, content } = loadPage('about');
const c = content as {
  heading: string;
  paragraphs: string[];
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
>
  <section class="page-section">
    <div class="about-grid">
      <div class="about-content">
        <h1>{c.heading}</h1>
        <div class="markdown">
          {c.paragraphs.map((p) => <p set:html={p}></p>)}
        </div>
      </div>
      <div class="about-rings-slot" aria-hidden="true">
        <div class="about-rings">
          <tree-rings seed="7" years="60" color="#2f8f3b" rotate></tree-rings>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/tree-rings.js';
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .page-section {
    overflow: clip;
    padding-block: 4rem;
    padding-inline: calc(var(--gutter) + 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 26rem) 1fr;
    gap: 3rem;
    align-items: center;
    min-height: calc(100dvh - var(--header-height) - 10rem);
  }

  .about-content {
    max-width: 26rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .markdown {
    max-width: 26rem;
  }

  .about-rings-slot {
    position: relative;
    height: 100%;
    min-height: 30rem;
  }

  .about-rings {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: 150%;
    aspect-ratio: 1 / 1;
    pointer-events: none;
  }

  :global(tree-rings) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @include xl {
    .about-grid {
      grid-template-columns: minmax(0, 24rem) 1fr;
      gap: 2rem;
    }
    .about-rings {
      width: 140%;
    }
  }

  @include large {
    .page-section {
      padding-inline: var(--gutter);
    }
    .about-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2rem;
    }
    .about-content {
      max-width: 100%;
    }
    .markdown {
      max-width: 100%;
    }
    .about-rings-slot {
      min-height: 22rem;
    }
    .about-rings {
      left: -25%;
      width: 130%;
      opacity: 0.7;
    }
  }

  @include small {
    .page-section {
      padding-block: 2rem;
    }
    .about-rings-slot {
      min-height: 16rem;
    }
    .about-rings {
      left: -20%;
      width: 120%;
    }
  }
</style>

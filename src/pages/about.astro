---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { loadPage } from '../lib/content';

const { meta, content } = loadPage('about');
const c = content as {
  heading: string;
  scene: { flatten: string; grow: string };
  paragraphs: string[];
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
>
  <section class="page-section">
    <div class="about-grid">
      <div class="about-content">
        <h1>{c.heading}</h1>
        <div class="markdown">
          {c.paragraphs.map((p) => <p set:html={p}></p>)}
        </div>
      </div>
      <div class="about-scene-slot">
        <tree-scene auto-rotate aria-hidden="true"></tree-scene>
        <Button
          class="about-scene-toggle"
          data-view="trees"
          data-label-flatten={c.scene.flatten}
          data-label-grow={c.scene.grow}
        >
          <svg slot="icon" class="about-scene-icon" viewBox="0 0 16 16" aria-hidden="true">
            <line class="ground" x1="2" y1="14" x2="14" y2="14" />
            <line class="trunk" x1="8" y1="8" x2="8" y2="14" />
            <circle class="canopy" cx="8" cy="6" r="4.5" />
          </svg>
          <span class="about-scene-label">{c.scene.flatten}</span>
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/tree-scene.js';

  function initScene() {
    const slot = document.querySelector<HTMLElement>('.about-scene-slot');
    if (!slot) return;
    const scene = slot.querySelector<HTMLElement & { toggle(): void }>('tree-scene');
    const button = slot.querySelector<HTMLButtonElement>('.about-scene-toggle button');
    const label = button?.querySelector<HTMLElement>('.about-scene-label');
    if (!scene || !button || !label) return;
    button.addEventListener('click', () => scene.toggle());
    scene.addEventListener('tt:scene-view', (e) => {
      const { view } = (e as CustomEvent<{ view: string }>).detail;
      button.dataset.view = view;
      label.textContent = view === 'trees' ? button.dataset.labelFlatten! : button.dataset.labelGrow!;
    });
  }

  document.addEventListener('astro:page-load', initScene);
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .page-section {
    overflow: clip;
    padding-block: 4rem;
    padding-inline: calc(var(--gutter) + 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 26rem) 1fr;
    gap: 3rem;
    align-items: center;
    min-height: calc(100dvh - var(--header-height) - 10rem);
  }

  .about-content {
    max-width: 26rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .markdown {
    max-width: 26rem;
  }

  .about-scene-slot {
    position: relative;
    height: 100%;
    min-height: 32rem;
    margin-right: calc(-1 * (var(--gutter) + 2rem));
  }

  :global(tree-scene) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .about-scene-toggle {
    position: absolute;
    bottom: -0.25rem;
    left: -1rem;
  }

  .about-scene-label {
    min-width: 2.75rem;
    text-align: left;
  }

  // Flat: a centred dot. Grown: the dot lifts while the trunk extends beneath it, then the ground line fades in
  @mixin icon-grown {
    .canopy { fill-opacity: 0.2; transform: none; transition-delay: 0ms; }
    .trunk { transform: none; transition-delay: 100ms; }
    .ground { opacity: 0.3; transition-delay: 300ms; }
  }

  @mixin icon-flat {
    .canopy { fill-opacity: 1; transform: translateY(2px); transition-delay: 150ms; }
    .trunk { transform: scaleY(0); transition-delay: 150ms; }
    .ground { opacity: 0; transition-delay: 0ms; }
  }

  .about-scene-icon {
    width: 0.85rem;
    height: 0.85rem;
    overflow: visible;
    stroke: var(--forest);
    stroke-width: 1.25;
    stroke-linecap: round;
    fill: none;

    .canopy,
    .trunk {
      transform-box: view-box;
    }

    .canopy {
      fill: var(--forest);
      transition: fill-opacity 300ms ease, transform 300ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .trunk {
      transform-origin: 8px 8px;
      transition: transform 300ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .ground {
      stroke: var(--charred);
      transition: opacity 250ms ease;
    }

    @include icon-grown;
  }

  // Hover previews the state a click would produce
  [data-view='map'] .about-scene-icon,
  .about-scene-toggle:hover [data-view='trees'] .about-scene-icon {
    @include icon-flat;
  }

  .about-scene-toggle:hover [data-view='map'] .about-scene-icon {
    @include icon-grown;
  }

  @include xl {
    .about-grid {
      grid-template-columns: minmax(0, 24rem) 1fr;
      gap: 2rem;
    }
  }

  @include large {
    .page-section {
      padding-inline: var(--gutter);
    }
    .about-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2rem;
    }
    .about-content {
      max-width: 100%;
    }
    .markdown {
      max-width: 100%;
    }
    .about-scene-slot {
      min-height: 26rem;
      margin-inline: calc(-1 * var(--gutter));
    }
    .about-scene-toggle {
      bottom: 0.5rem;
      left: var(--gutter);
    }
  }

  @include small {
    .page-section {
      padding-block: 2rem;
    }
    .about-scene-slot {
      min-height: 20rem;
    }
  }
</style>

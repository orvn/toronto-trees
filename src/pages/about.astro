---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPage } from '../lib/content';

const { meta, content } = loadPage('about');
const c = content as {
  heading: string;
  paragraphs: string[];
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
>
  <section class="page-section">
    <h1>{c.heading}</h1>
    <div class="markdown">
      {c.paragraphs.map((p) => <p set:html={p}></p>)}
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  .page-section {
    padding-block: 4rem;
    padding-inline: calc(var(--gutter) + 2rem);
    padding-right: calc(var(--gutter) + 4rem);
  }

  h1 {
    margin-bottom: 2rem;
  }

  .markdown {
    max-width: 62ch;
  }

  @include small {
    .page-section {
      padding-block: 2rem;
      padding-inline: var(--gutter);
    }
  }
</style>

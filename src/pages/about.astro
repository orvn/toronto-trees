---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPage } from '../lib/content';

const { meta, content } = loadPage('about');
const c = content as {
  heading: string;
  scene: { hint_drag: string; hint_hover: string; flatten: string; grow: string };
  paragraphs: string[];
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  ogImage={meta.og_image}
>
  <section class="page-section">
    <div class="about-grid">
      <div class="about-content">
        <h1>{c.heading}</h1>
        <div class="markdown">
          {c.paragraphs.map((p) => <p set:html={p}></p>)}
        </div>
      </div>
      <div class="about-scene-slot">
        <tree-scene auto-rotate aria-hidden="true"></tree-scene>
        <div class="about-scene-controls">
          <span class="about-scene-hint">
            {c.scene.hint_drag}<span class="about-scene-hint-hover"> · {c.scene.hint_hover}</span>
          </span>
          <button
            type="button"
            class="about-scene-toggle"
            data-label-flatten={c.scene.flatten}
            data-label-grow={c.scene.grow}
          >{c.scene.flatten}</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/tree-scene.js';

  function initScene() {
    const slot = document.querySelector<HTMLElement>('.about-scene-slot');
    if (!slot) return;
    const scene = slot.querySelector<HTMLElement & { toggle(): void }>('tree-scene');
    const button = slot.querySelector<HTMLButtonElement>('.about-scene-toggle');
    if (!scene || !button) return;
    button.addEventListener('click', () => scene.toggle());
    scene.addEventListener('tt:scene-view', (e) => {
      const { view } = (e as CustomEvent<{ view: string }>).detail;
      button.textContent = view === 'trees' ? button.dataset.labelFlatten! : button.dataset.labelGrow!;
    });
  }

  document.addEventListener('astro:page-load', initScene);
</script>

<style lang="scss">
  @use '../styles/breakpoints' as *;

  .page-section {
    overflow: clip;
    padding-block: 4rem;
    padding-inline: calc(var(--gutter) + 2rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 26rem) 1fr;
    gap: 3rem;
    align-items: center;
    min-height: calc(100dvh - var(--header-height) - 10rem);
  }

  .about-content {
    max-width: 26rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  .markdown {
    max-width: 26rem;
  }

  .about-scene-slot {
    position: relative;
    height: 100%;
    min-height: 32rem;
    margin-right: calc(-1 * (var(--gutter) + 2rem));
  }

  :global(tree-scene) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .about-scene-controls {
    position: absolute;
    right: calc(var(--gutter) + 2rem);
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: var(--text-xs);
    color: var(--battleship);
  }

  @media (hover: none), (pointer: coarse) {
    .about-scene-hint-hover {
      display: none;
    }
  }

  .about-scene-toggle {
    font: inherit;
    font-weight: 500;
    color: var(--forest);
    background: transparent;
    border: 1px solid var(--forest);
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;

    &:hover,
    &:focus-visible {
      background: var(--forest);
      color: var(--cararra);
    }
  }

  @include xl {
    .about-grid {
      grid-template-columns: minmax(0, 24rem) 1fr;
      gap: 2rem;
    }
  }

  @include large {
    .page-section {
      padding-inline: var(--gutter);
    }
    .about-grid {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 2rem;
    }
    .about-content {
      max-width: 100%;
    }
    .markdown {
      max-width: 100%;
    }
    .about-scene-slot {
      min-height: 26rem;
      margin-inline: calc(-1 * var(--gutter));
    }
    .about-scene-controls {
      right: var(--gutter);
      left: var(--gutter);
      justify-content: space-between;
    }
  }

  @include small {
    .page-section {
      padding-block: 2rem;
    }
    .about-scene-slot {
      min-height: 20rem;
    }
    .about-scene-hint {
      display: none;
    }
  }
</style>

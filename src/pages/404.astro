---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import LeafScatter from '../components/LeafScatter.astro';
import { loadPage } from '../lib/content';

const { meta, options, content } = loadPage('404');
const c = content as {
  code: string;
  heading: string;
  message: string;
  cta: string;
  cta_href: string;
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  noindex={options?.noindex ?? false}
>
  <section class="error-page">
    <LeafScatter text={c.code} />
    <div class="container">
      <h1>{c.heading}</h1>
      <p class="error-message">{c.message}</p>
      <Button href={c.cta_href} size="large">{c.cta}</Button>
    </div>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  .error-page {
    padding-block: 2rem 6rem;
    text-align: center;
  }

  .error-page .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  h1 {
    font-size: var(--text-2xl);
    max-width: 30ch;
    text-wrap: balance;
  }

  .error-message {
    margin-top: -0.6rem;
    color: var(--battleship);
    max-width: 40ch;
    text-wrap: pretty;
  }

  @include small {
    .error-page {
      padding-block: 1rem 3rem;
    }
  }
</style>

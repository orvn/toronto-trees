---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import LeafScatter from '../components/LeafScatter.astro';
import { loadPage } from '../lib/content';

const { meta, options, content } = loadPage('404');
const c = content as {
  code: string;
  heading: string;
  message: string;
  cta: string;
  cta_href: string;
  replay: string;
};
---

<BaseLayout
  title={meta.title ?? undefined}
  description={meta.description}
  noindex={options?.noindex ?? false}
>
  <section class="error-page">
    <LeafScatter text={c.code}>
      <div class="container">
        <h1>{c.heading}</h1>
        <p class="error-message">{c.message}</p>
        <div class="error-actions">
          <a href={c.cta_href} class="btn btn-primary magnify-onhover">{c.cta}</a>
          <Button x-on:click="replay">{c.replay}</Button>
        </div>
      </div>
    </LeafScatter>
  </section>
</BaseLayout>

<style lang="scss">
  @use '../styles/breakpoints' as *;
  .error-page {
    padding-block: 2rem 6rem;
    text-align: center;
  }

  .error-page .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  h1 {
    max-width: 30ch;
    text-wrap: balance;
  }

  .error-message {
    color: var(--battleship);
    max-width: 40ch;
    text-wrap: pretty;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  @include small {
    .error-page {
      padding-block: 1rem 3rem;
    }
  }
</style>

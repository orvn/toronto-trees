{
  "name": "toronto-trees",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "bun run copy:maplibre && astro dev",
    "build": "bun run copy:maplibre && astro build",
    "preview": "astro preview",
    "astro":  "astro",
    "copy:maplibre": "mkdir -p public/vendor/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/vendor/maplibre/"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/sitemap": "^3.7.2",
    "@toon-format/toon": "^2.1.0",
    "alpinejs": "^3.15.10",
    "astro": "^6.1.3",
    "maplibre-gl": "^6.6.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "sass": "^1.100.0"
  }
}
